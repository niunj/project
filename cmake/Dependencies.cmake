# Repository-owned engine dependencies. No download or system engine fallback.
include_guard(GLOBAL)
include(CMakePackageConfigHelpers)
# CMake's in-place install-time RPATH editing pads the build RPATH with
# colons. On Linux an empty path element lets the loader search the cwd.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_GENERATOR STREQUAL "Unix Makefiles")
    set(CMAKE_NO_BUILTIN_CHRPATH ON)
endif()
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export compilation provenance" FORCE)
option(BUILD_SHARED_LIBS "Build vendored engine libraries as shared libraries" ON)
option(VSGRAYSIM_ALLOW_LOCAL_DEPENDENCY_CHANGES "Allow audited local changes to locked dependency sources" OFF)
set(VSGRAYSIM_DEPENDENCY_MODE "vendored" CACHE STRING "Engine dependency provider" FORCE)
set(_engine_sources "${CMAKE_SOURCE_DIR}/third_party")
set(_engine_binary "${CMAKE_BINARY_DIR}/third_party")
set(_engine_packages "${CMAKE_BINARY_DIR}/cmake/local-packages")

find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_verify_arguments --repo "${CMAKE_SOURCE_DIR}")
if(VSGRAYSIM_ALLOW_LOCAL_DEPENDENCY_CHANGES)
    list(APPEND _verify_arguments --allow-local-changes)
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/dependencies/verify_sources.py" ${_verify_arguments} --json
    RESULT_VARIABLE _verify_status OUTPUT_VARIABLE _verification ERROR_VARIABLE _verify_error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _verify_status EQUAL 0)
    message(FATAL_ERROR "Locked dependency verification failed (${_verify_status}): ${_verify_error}\n${_verification}")
endif()
set_property(GLOBAL PROPERTY VSGRAYSIM_SOURCE_VERIFICATION "${_verification}")
add_custom_target(vsgraysim_verify_dependencies ALL
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/dependencies/verify_sources.py" ${_verify_arguments}
    COMMENT "Verifying locked engine source snapshots" VERBATIM)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/third_party/upstream.lock.json")

foreach(_component vsg vsgXchange vsgImGui vsgBullet rocky glm json spdlog entt)
    if(NOT IS_DIRECTORY "${_engine_sources}/${_component}")
        message(FATAL_ERROR "Locked dependency source is missing: third_party/${_component}. Restore repository sources; configure never downloads or uses preinstalled engines.")
    endif()
endforeach()

# Config bridges describe real in-tree targets, not installed binary packages.
# Upstream components use find_package even in add_subdirectory builds.
function(_vsgraysim_source_package package target version extra)
    set(_directory "${_engine_packages}/${package}")
    file(MAKE_DIRECTORY "${_directory}")
    file(WRITE "${_directory}/${package}Config.cmake"
        "if(NOT TARGET ${target})\n  message(FATAL_ERROR \"Local target ${target} is not configured\")\nendif()\nset(${package}_FOUND TRUE)\nset(${package}_VERSION \"${version}\")\n${extra}\n")
    write_basic_package_version_file("${_directory}/${package}ConfigVersion.cmake"
        VERSION "${version}" COMPATIBILITY SameMajorVersion)
    set(${package}_DIR "${_directory}" CACHE PATH "Repository target package bridge" FORCE)
    set(${package}_DIR "${_directory}" PARENT_SCOPE)
    # The upstream VSG projects set this flag, which breaks REQUIRED callers.
    unset(CMAKE_DISABLE_FIND_PACKAGE_${package} CACHE)
    set(CMAKE_DISABLE_FIND_PACKAGE_${package} FALSE PARENT_SCOPE)
endfunction()

# Header dependencies are deliberately imported interface targets: their exact
# source trees are locked alongside the compiled engines, with no hidden fmt ABI.
set(GLM_INCLUDE_DIR "${_engine_sources}/glm" CACHE PATH "Locked glm headers" FORCE)
set(JSON_INCLUDE_DIR "${_engine_sources}/json/include" CACHE PATH "Locked JSON headers" FORCE)
set(SPDLOG_INCLUDE_DIR "${_engine_sources}/spdlog/include" CACHE PATH "Locked spdlog and bundled fmt headers" FORCE)
set(ENTT_INCLUDE_DIR "${_engine_sources}/entt/src" CACHE PATH "Locked EnTT headers" FORCE)
foreach(_record "glm::glm|${GLM_INCLUDE_DIR}" "nlohmann_json::nlohmann_json|${JSON_INCLUDE_DIR}" "spdlog::spdlog|${SPDLOG_INCLUDE_DIR}" "EnTT::EnTT|${ENTT_INCLUDE_DIR}")
    string(REPLACE "|" ";" _record "${_record}")
    list(GET _record 0 _target)
    list(GET _record 1 _include)
    if(NOT TARGET "${_target}")
        add_library("${_target}" INTERFACE IMPORTED GLOBAL)
        set_target_properties("${_target}" PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_include}")
    endif()
endforeach()
_vsgraysim_source_package(glm glm::glm 0.9.9.8 "")
_vsgraysim_source_package(nlohmann_json nlohmann_json::nlohmann_json 3.11.2 "")
_vsgraysim_source_package(spdlog spdlog::spdlog 1.10.0 "")
# EnTT's exact pinned revision is recorded by upstream.lock.json; no upstream
# consumer in this graph requests a version range.
_vsgraysim_source_package(EnTT EnTT::EnTT 3.13.2 "")

# External SDKs stay explicit in this first source-management phase.
set(ROCKY_EARTH3P_DIR "${THIRD_PARTY_ROOT}/earth_3rdparty" CACHE PATH "External GDAL/PROJ SDK")
list(PREPEND CMAKE_PREFIX_PATH "${ROCKY_EARTH3P_DIR}")
find_package(Vulkan REQUIRED)
find_package(CUDAToolkit REQUIRED)
find_package(Threads REQUIRED)
find_package(ZLIB REQUIRED)
set(BULLET_ROOT "${THIRD_PARTY_ROOT}/bullet3/install" CACHE PATH "External Bullet SDK")
find_package(Bullet REQUIRED)
find_path(SIM_GDAL_INCLUDE gdal.h HINTS "${ROCKY_EARTH3P_DIR}/include" REQUIRED)
find_library(SIM_GDAL_LIBRARY gdal HINTS "${ROCKY_EARTH3P_DIR}/lib" REQUIRED)
set(GDAL_INCLUDE_DIR "${SIM_GDAL_INCLUDE}" CACHE PATH "Selected GDAL headers" FORCE)
set(GDAL_LIBRARY "${SIM_GDAL_LIBRARY}" CACHE FILEPATH "Selected GDAL binary" FORCE)
find_package(GDAL REQUIRED)
find_package(PROJ CONFIG REQUIRED HINTS "${ROCKY_EARTH3P_DIR}/lib/cmake/proj")
find_package(glslang CONFIG REQUIRED)
find_package(SPIRV-Tools-opt CONFIG REQUIRED)

# Feature policy is fixed, rather than following whichever optional packages
# happen to be installed on the configuring machine.
set(VSG_SUPPORTS_ShaderCompiler ON CACHE BOOL "Runtime shader compilation is required" FORCE)
set(VSG_SUPPORTS_ShaderOptimizer ON CACHE BOOL "Pinned shader optimizer feature" FORCE)
set(VSG_SUPPORTS_Windowing ON CACHE BOOL "Native product windows" FORCE)
set(VSG_USE_dynamic_cast OFF CACHE BOOL "Pinned VSG casting implementation" FORCE)
add_subdirectory("${_engine_sources}/vsg" "${_engine_binary}/vsg" EXCLUDE_FROM_ALL)
_vsgraysim_source_package(vsg vsg::vsg 1.1.15 "include(\"${_engine_sources}/vsg/cmake/vsgMacros.cmake\")")
include("${_engine_sources}/vsg/cmake/vsgMacros.cmake")

foreach(_feature assimp GDAL curl freetype ktx OSG meshoptimizer draco)
    set(vsgXchange_${_feature} OFF CACHE BOOL "Pinned vsgXchange feature" FORCE)
endforeach()
set(vsgXchange_openexr ON CACHE BOOL "Preserve existing OpenEXR reader" FORCE)
find_package(OpenEXR REQUIRED)
add_subdirectory("${_engine_sources}/vsgXchange" "${_engine_binary}/vsgXchange" EXCLUDE_FROM_ALL)
_vsgraysim_source_package(vsgXchange vsgXchange::vsgXchange 1.1.14 "")

# Nested ImGui/ImPlot sources must already be present: no configure-time git.
foreach(_header src/imgui/imgui.h src/implot/implot.h)
    if(NOT EXISTS "${_engine_sources}/vsgImGui/${_header}")
        message(FATAL_ERROR "Missing locked vsgImGui nested source: ${_header}")
    endif()
endforeach()
set(SHOW_DEMO_WINDOW OFF CACHE BOOL "No third-party demo UI in products" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/VsgImGui.cmake")
_vsgraysim_source_package(vsgImGui vsgImGui::vsgImGui 0.7.0 "")

include("${CMAKE_CURRENT_LIST_DIR}/VsgBullet.cmake")

option(VSGRAYSIM_WITH_ROCKY "Build the legacy Rocky globe and standalone Rocky viewer" ON)
if(VSGRAYSIM_WITH_ROCKY)
set(ROCKY_BUILD_SHARED_LIBS "${BUILD_SHARED_LIBS}" CACHE BOOL "Shared Rocky ABI policy" FORCE)
set(ROCKY_RENDERER_VSG ON CACHE BOOL "Rocky VSG backend" FORCE)
set(ROCKY_SUPPORTS_GDAL ON CACHE BOOL "Offline geospatial datasets" FORCE)
foreach(_feature HTTPLIB CURL HTTPS MBTILES AZURE BING IMGUI QT)
    set(ROCKY_SUPPORTS_${_feature} OFF CACHE BOOL "Pinned offline Rocky feature" FORCE)
endforeach()
add_subdirectory("${_engine_sources}/rocky" "${_engine_binary}/rocky" EXCLUDE_FROM_ALL)
# The external GDAL shared library does not carry a search path for its
# sibling GEOS libraries. Pass Rocky's selected SDK directory to the loader
# for transitive dependencies, including consumers loading Rocky directly.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_options(rocky PRIVATE "-Wl,--disable-new-dtags")
endif()
if(NOT TARGET rocky::rocky)
    add_library(rocky::rocky ALIAS rocky)
endif()
# Upstream Rocky does not publish build-tree include usage requirements.
target_include_directories(rocky PUBLIC
    $<BUILD_INTERFACE:${_engine_sources}/rocky/src>
    $<BUILD_INTERFACE:${_engine_binary}/rocky/build_include>)
set(ROCKY_ROOT "${_engine_binary}/rocky" CACHE PATH "Locally built Rocky resources" FORCE)
set(VSGRAYSIM_ROCKY_RESOURCE_DIR "${_engine_sources}/rocky/src/rocky/vsg" CACHE INTERNAL "Local Rocky resource source")
set(VSGRAYSIM_ROCKY_TARGET rocky::rocky)
endif()
set(VSGRAYSIM_ROCKY_FILE_PATH "${CMAKE_BINARY_DIR}/share/rocky")
set(VSGRAYSIM_PROJ_DATA_PATH "${ROCKY_EARTH3P_DIR}/share/proj")
set(VSGRAYSIM_GDAL_DATA_PATH "${ROCKY_EARTH3P_DIR}/share/gdal")
add_compile_definitions(
    VSGRAYSIM_ROCKY_FILE_PATH="${VSGRAYSIM_ROCKY_FILE_PATH}"
    VSGRAYSIM_PROJ_DATA_PATH="${VSGRAYSIM_PROJ_DATA_PATH}"
    VSGRAYSIM_GDAL_DATA_PATH="${VSGRAYSIM_GDAL_DATA_PATH}")
if(VSGRAYSIM_WITH_ROCKY)
file(MAKE_DIRECTORY "${VSGRAYSIM_ROCKY_FILE_PATH}/data")
file(COPY "${_engine_sources}/rocky/src/rocky/vsg/shaders" DESTINATION "${VSGRAYSIM_ROCKY_FILE_PATH}")
file(COPY "${_engine_sources}/rocky/data/fonts/times.vsgb" DESTINATION "${VSGRAYSIM_ROCKY_FILE_PATH}/data")
add_custom_target(vsgraysim_dependency_resources ALL
    COMMAND "${CMAKE_COMMAND}" -E copy_directory
        "${_engine_sources}/rocky/src/rocky/vsg/shaders" "${VSGRAYSIM_ROCKY_FILE_PATH}/shaders"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${_engine_sources}/rocky/data/fonts/times.vsgb" "${VSGRAYSIM_ROCKY_FILE_PATH}/data/times.vsgb"
    COMMENT "Synchronizing repository-owned Rocky shader resources")
add_dependencies(rocky vsgraysim_dependency_resources)
endif()

# The build tree is the only engine library search domain. External SDK
# directories remain explicit until their separate source-management phase.
set(VSGRAYSIM_ENGINE_RPATH_DIRS
    "$<TARGET_FILE_DIR:vsg>" "$<TARGET_FILE_DIR:vsgXchange>"
    "$<TARGET_FILE_DIR:vsgImGui>"
    "$<TARGET_FILE_DIR:vsgbDynamics>" "$<TARGET_FILE_DIR:vsgbCollision>")
if(VSGRAYSIM_WITH_ROCKY)
    list(APPEND VSGRAYSIM_ENGINE_RPATH_DIRS "$<TARGET_FILE_DIR:rocky>")
    add_dependencies(rocky vsgraysim_verify_dependencies)
endif()
foreach(_target vsg vsgXchange vsgImGui vsgbDynamics vsgbCollision)
    add_dependencies(${_target} vsgraysim_verify_dependencies)
endforeach()

function(_vsgraysim_json_quote output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
function(vsgraysim_write_dependency_report)
    set(_report "{\"schema\":\"vsgraysim.dependencies\",\"version\":1,\"mode\":\"vendored\"}")
    _vsgraysim_json_quote(_value "${CMAKE_SOURCE_DIR}")
    string(JSON _report SET "${_report}" source_root "${_value}")
    if(VSGRAYSIM_WITH_ROCKY)
        set(_rocky_json true)
    else()
        set(_rocky_json false)
    endif()
    string(JSON _report SET "${_report}" rocky_enabled "${_rocky_json}")
    set(_dependencies "[]")
    set(_index 0)
    foreach(_record "vsg|vsg|1.1.15" "vsgXchange|vsgXchange|1.1.14" "vsgImGui|vsgImGui|0.7.0" "vsgBullet|vsgbCollision|3.00.00" "vsgBullet|vsgbDynamics|3.00.00" "rocky|rocky|1.1.0")
        string(REPLACE "|" ";" _record "${_record}")
        list(GET _record 0 _component)
        list(GET _record 1 _target)
        list(GET _record 2 _version)
        if(_target STREQUAL "rocky" AND NOT VSGRAYSIM_WITH_ROCKY)
            continue()
        endif()
        get_target_property(_type "${_target}" TYPE)
        set(_entry "{\"managed\":true}")
        foreach(_field name target version source_dir binary_dir artifact type)
            if(_field STREQUAL "name")
                set(_raw "${_target}")
            elseif(_field STREQUAL "target")
                set(_raw "${_target}")
            elseif(_field STREQUAL "version")
                set(_raw "${_version}")
            elseif(_field STREQUAL "source_dir")
                set(_raw "${CMAKE_SOURCE_DIR}/third_party/${_component}")
            elseif(_field STREQUAL "binary_dir")
                set(_raw "${CMAKE_BINARY_DIR}/third_party/${_component}")
            elseif(_field STREQUAL "artifact")
                set(_raw "$<TARGET_FILE:${_target}>")
            else()
                set(_raw "${_type}")
            endif()
            _vsgraysim_json_quote(_value "${_raw}")
            string(JSON _entry SET "${_entry}" "${_field}" "${_value}")
        endforeach()
        string(JSON _dependencies SET "${_dependencies}" ${_index} "${_entry}")
        math(EXPR _index "${_index}+1")
    endforeach()
    string(JSON _report SET "${_report}" dependencies "${_dependencies}")
    get_property(_verification GLOBAL PROPERTY VSGRAYSIM_SOURCE_VERIFICATION)
    string(JSON _report SET "${_report}" verification "${_verification}")
    set(_toolchain "{}")
    foreach(_field CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION CMAKE_CUDA_COMPILER CMAKE_CUDA_COMPILER_VERSION CMAKE_BUILD_TYPE CMAKE_GENERATOR CMAKE_VERSION CMAKE_CUDA_ARCHITECTURES)
        _vsgraysim_json_quote(_value "${${_field}}")
        string(JSON _toolchain SET "${_toolchain}" "${_field}" "${_value}")
    endforeach()
    string(JSON _report SET "${_report}" toolchain "${_toolchain}")
    # CMake 3.22's FindVulkan and FindBullet omit versions. Read the
    # selected headers so the report identifies the SDK used by this build.
    if(NOT Vulkan_VERSION)
        set(_vk_header "${Vulkan_INCLUDE_DIR}/vulkan/vulkan_core.h")
        file(STRINGS "${_vk_header}" _vk_patch REGEX "^#define VK_HEADER_VERSION +[0-9]+")
        file(STRINGS "${_vk_header}" _vk_api REGEX "^#define VK_HEADER_VERSION_COMPLETE VK_MAKE_API_VERSION")
        if(_vk_patch MATCHES "VK_HEADER_VERSION +([0-9]+)")
            set(_patch "${CMAKE_MATCH_1}")
            if(_vk_api MATCHES "VK_MAKE_API_VERSION[(]0, *([0-9]+), *([0-9]+),")
                set(Vulkan_VERSION "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${_patch}")
            endif()
        endif()
    endif()
    if(NOT BULLET_VERSION_STRING)
        file(STRINGS "${BULLET_INCLUDE_DIR}/LinearMath/btScalar.h" _bt_version REGEX "^#define BT_BULLET_VERSION +[0-9]+")
        if(_bt_version MATCHES "BT_BULLET_VERSION +([0-9]+)")
            set(_encoded "${CMAKE_MATCH_1}")
            math(EXPR _major "${_encoded} / 100")
            math(EXPR _minor "${_encoded} % 100")
            set(BULLET_VERSION_STRING "${_major}.${_minor}")
        endif()
    endif()
    set(_external "{}")
    foreach(_field VULKAN_SDK Vulkan_VERSION Vulkan_LIBRARY CUDAToolkit_ROOT CUDAToolkit_VERSION BULLET_ROOT BULLET_VERSION_STRING BULLET_DYNAMICS_LIBRARY ROCKY_EARTH3P_DIR GDAL_VERSION GDAL_LIBRARY GDAL_INCLUDE_DIR PROJ_VERSION PROJ_DIR GLSLC glslang_DIR SPIRV-Tools-opt_DIR OpenEXR_DIR OpenEXR_VERSION QT6_PREFIX Qt6_VERSION)
        _vsgraysim_json_quote(_value "${${_field}}")
        string(JSON _external SET "${_external}" "${_field}" "${_value}")
    endforeach()
    string(JSON _report SET "${_report}" external_dependencies "${_external}")
    string(JSON _report SET "${_report}" features "{\"vsg_shader_compiler\":true,\"vsg_shader_optimizer\":true,\"xchange_openexr\":true,\"xchange_assimp\":false,\"xchange_gdal\":false,\"xchange_curl\":false,\"xchange_freetype\":false,\"rocky_gdal\":${_rocky_json},\"rocky_http\":false}")
    if(VSGRAYSIM_ALLOW_LOCAL_DEPENDENCY_CHANGES)
        string(JSON _report SET "${_report}" allow_local_changes true)
    else()
        string(JSON _report SET "${_report}" allow_local_changes false)
    endif()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/dependency-report.json" CONTENT "${_report}\n")
endfunction()
