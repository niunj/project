# Optional external OpenSceneGraph SDK, used only at asset-import time.
# Core VSG and all vendored sources retain their locked build configuration.
option(VSGRAYSIM_ENABLE_OSG_IMPORT "Read .osg/.osgb/.ive voxel target assets" ON)
set(OPENSCENEGRAPH_ROOT "" CACHE PATH "External OpenSceneGraph SDK prefix")
if(VSGRAYSIM_ENABLE_OSG_IMPORT)
    find_path(VOXEL_OSG_INCLUDE osg/Node HINTS "${OPENSCENEGRAPH_ROOT}/include" REQUIRED)
    find_library(VOXEL_OSG_LIBRARY NAMES osg HINTS "${OPENSCENEGRAPH_ROOT}/lib" REQUIRED)
    find_library(VOXEL_OSGDB_LIBRARY NAMES osgDB HINTS "${OPENSCENEGRAPH_ROOT}/lib" REQUIRED)
    find_library(VOXEL_OPENTHREADS_LIBRARY NAMES OpenThreads HINTS "${OPENSCENEGRAPH_ROOT}/lib" REQUIRED)
    get_filename_component(_voxel_osg_library_dir "${VOXEL_OSGDB_LIBRARY}" DIRECTORY)
    file(GLOB _voxel_osg_plugins LIST_DIRECTORIES TRUE "${_voxel_osg_library_dir}/osgPlugins-*")
    find_path(VOXEL_OSG_PLUGIN_DIR NAMES osgdb_osg.so HINTS ${_voxel_osg_plugins} REQUIRED)
    if(NOT EXISTS "${VOXEL_OSG_PLUGIN_DIR}/osgdb_ive.so")
        message(FATAL_ERROR "OSG SDK must provide both osg and ive reader plugins")
    endif()
    target_compile_definitions(vsgraysim_voxel_earth PRIVATE VOXEL_OSG_PLUGIN_DIR="${VOXEL_OSG_PLUGIN_DIR}")
    target_include_directories(vsgraysim_voxel_earth PRIVATE "${VOXEL_OSG_INCLUDE}")
    target_link_libraries(vsgraysim_voxel_earth PRIVATE "${VOXEL_OSGDB_LIBRARY}" "${VOXEL_OSG_LIBRARY}" "${VOXEL_OPENTHREADS_LIBRARY}")
    # Apply RPATH to transitive SDK dependencies/plugins as well on Linux.
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_options(vsgraysim_voxel_earth INTERFACE "-Wl,--disable-new-dtags")
    endif()
    message(STATUS "Voxel OSG/IVE import: ${VOXEL_OSGDB_LIBRARY}")
endif()
target_compile_definitions(vsgraysim_voxel_earth PUBLIC VSGRAYSIM_OSG_IMPORT=$<BOOL:${VSGRAYSIM_ENABLE_OSG_IMPORT}>)
