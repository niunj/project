#version 450
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(set=0,binding=0,rgba32f) readonly uniform image3D state0;
layout(set=0,binding=1,rgba32f) uniform image3D state1;
layout(set=0,binding=2,rgba32f) readonly uniform image3D velocity0;
layout(set=0,binding=3,rgba32f) uniform image3D velocity1;
layout(set=0,binding=8,rgba32f) readonly uniform image3D backwardState;
layout(set=0,binding=9,rgba32f) readonly uniform image3D backwardVelocity;
layout(std140,set=0,binding=4) uniform CloudParams {
    vec4 originCell; vec4 gridDt; vec4 windHumidity; vec4 thermo;
    vec4 phase; vec4 flow; vec4 colliderMeta;
    vec4 colliderCentre[32]; vec4 colliderVelocity[32];
} p;

ivec3 bound(ivec3 c){return clamp(c,ivec3(0),ivec3(p.gridDt.xyz)-1);}
void stateExtrema(ivec3 c,out vec4 low,out vec4 high) {
    low=high=imageLoad(state0,c);
    const ivec3 offsets[6]=ivec3[6](ivec3(1,0,0),ivec3(-1,0,0),ivec3(0,1,0),
        ivec3(0,-1,0),ivec3(0,0,1),ivec3(0,0,-1));
    for(int i=0;i<6;++i){vec4 v=imageLoad(state0,bound(c+offsets[i]));low=min(low,v);high=max(high,v);}
}
void velocityExtrema(ivec3 c,out vec4 low,out vec4 high) {
    low=high=imageLoad(velocity0,c);
    const ivec3 offsets[6]=ivec3[6](ivec3(1,0,0),ivec3(-1,0,0),ivec3(0,1,0),
        ivec3(0,-1,0),ivec3(0,0,1),ivec3(0,0,-1));
    for(int i=0;i<6;++i){vec4 v=imageLoad(velocity0,bound(c+offsets[i]));low=min(low,v);high=max(high,v);}
}
void main() {
    ivec3 c=ivec3(gl_GlobalInvocationID.xyz),n=ivec3(p.gridDt.xyz);
    if(any(greaterThanEqual(c,n)))return;
    vec4 stateLow,stateHigh,velocityLow,velocityHigh;
    stateExtrema(c,stateLow,stateHigh);velocityExtrema(c,velocityLow,velocityHigh);
    vec4 correctedState=imageLoad(state1,c)+.5*(imageLoad(state0,c)-imageLoad(backwardState,c));
    vec4 correctedVelocity=imageLoad(velocity1,c)+.5*(imageLoad(velocity0,c)-imageLoad(backwardVelocity,c));
    correctedState=clamp(correctedState,stateLow,stateHigh);
    correctedState.r=max(correctedState.r,0.0);correctedState.g=max(correctedState.g,0.0);
    correctedState.a=max(correctedState.a,0.0);
    imageStore(state1,c,correctedState);
    imageStore(velocity1,c,clamp(correctedVelocity,velocityLow,velocityHigh));
}
