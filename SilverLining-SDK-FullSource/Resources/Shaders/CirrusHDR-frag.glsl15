#if OPENGL
#else
#if SLVULKAN
layout(location = 0) in vec4 vertColor;
layout(location = 1) in vec4 vertTexcoord;
#else
in vec4 vertColor;
in vec3 vertTexcoord;
#endif
#endif

#if SLVULKAN
layout(set = 1, binding = 0) uniform sampler2D sl_tex2D;
#else
uniform sampler2D sl_tex2D;
#endif

void overrideCirrusColor(in vec4 texel, in vec4 litColor, inout vec4 finalColor);
void writeFragmentData(in vec4 finalColor);

void main()
{
#if OPENGL
    vec4 texel = texture2D(sl_tex2D, gl_TexCoord[0].xy + sl_textureOffset.xy);
    vec4 finalColor = texel * gl_Color;
    overrideCirrusColor(texel, gl_Color, finalColor);
#else
    vec4 texel = texture(sl_tex2D, vertTexcoord.st + sl_textureOffset.st);
    vec4 finalColor = texel * vertColor;
    overrideCirrusColor(texel, vertColor, finalColor);
#endif
    finalColor.xyz *= sl_outputScale.xyz;
    writeFragmentData(finalColor);
}