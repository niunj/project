# Configuration file for SilverLining

##########################
# General Settings
##########################

# Whether to use uniform buffer objects in the OPENGL32CORE, OPENGL renderers
use-ubos = yes

# Sets debug names for OpenGL, DirectX
# Currently only implemented for OpenGL & Vulkan
enable-renderer-object-names = yes

# Restores the back buffer to what it was after performing lighting calculations.
# Useful if you don't render the sky by passing false to Atmosphere::BeginFrame()
# and you don't want BeginFrame() to pollute the back buffer under any circumstances.
# This comes at a performance cost whenever the simulated time of day is modified.

preserve-back-buffer = no

# Toggles whether cull tests are performed on entire cloud layers. Useful if
# you have many cloud layers, some of which may be off screen.
enable-cloud-layer-culling = no

# Creates an offscreen render target for the cloud lighting pass. This
# option will allow you to do full screen antialiasing on systems that
# don't permit FSAA on lockable backbuffers, but not requiring pixel
# read back from the backbuffer. It takes more video memory, however.
# This is only relevant for DirectX9 developers, and will be enabled for
# DirectX10 users regardless of what is set here.
render-offscreen = yes

# The dimension of the offscreen buffer, if render-offscreen is true.
offscreen-dimension = 512

# Default location (degrees of latitude and longitude, west longitude is negative,
# north latitude is positive. Altitude is in meters.)

default-longitude = -122.064840
default-latitude = 30
default-altitude = 100.0

# Default time. The timezone is in hour offset from GST. (EST = -5, CST = -6,
# MST = -7, PST = -8)

default-year = 2011
default-month = 8
default-day = 15
default-hour = 12
default-minute = 0
default-second = 0
default-dst = yes
default-timezone = -8

# Overall brightness of tone mapping.
brightness = 0.7

# Enable or disable tone mapping altogether. Disabling it will lead to smoother day/night transitions and
# richer colors in some situations, but at the cost of very dark nights.
disable-tone-mapping = no

# Whether SilverLining sets a known good rendering state prior to doing its own drawing. Normally
# setting this to no is very unsafe, but if your engine does not have any unusual state set prior
# to calling SilverLining you can sometimes get away with it and gain a very small amount of performance
# back.
set-default-state = yes

# Whether to force the ambient light to be monochrome, instead of having a blue tint imparted by skylight.
force-monochrome-ambient = yes

# If set to "yes", SilverLining will not attempt to capture the currently bound shaders and render targets,
# nor restore them when done drawing. These calls can result in a pipeline stall, but are necessary for
# restoring OpenGL's state back to what it was. If you can ensure that your application will restore the
# previously bound shaders and render targets surrounding calls to DrawSky, DrawObjects, and GetEnvironmentMap,
# then you can try setting this to "yes" to potentially improve performance.
avoid-opengl-stalls = no

# If set to "yes", geometry for cloud billboards is created only on demand, as needed.
# This can save around 50% of SilverLining's VRAM usage. If cloud growth is enabled
# prior to setting the cloud layer, this option will be automatically disabled.
lazy-voxel-creation = yes

# Filenames for "user shaders" used to extend SilverLining in OpenGL. You can redirect these to your
# own files to simplify SDK updates.
user-vert-shader-file-opengl = Shaders/UserFunctions.glsl
user-frag-shader-file-opengl = Shaders/UserFunctions-frag.glsl
user-vert-shader-file-opengl32 = Shaders/UserFunctions.glsl15
user-frag-shader-file-opengl32 = Shaders/UserFunctions-frag.glsl15
user-vert-shader-file-vulkan = Shaders/UserFunctions.vulkan.vert
user-frag-shader-file-vulkan= Shaders/UserFunctions.vulkan.frag

# Whether blending and culling state is applied "lazily" within SilverLining, only in response
# to states that are changed. If you're running into problems while managing your own drawing
# with improper blending states being applied, try setting this to "yes"
always-apply-state = no

# Whether textured are shared across different rendering contexts.
# Generally, SilverLining tries to minimize texture memory by sharing
# texture data across different rendering contexts.
# In some applications/cases this may not be possible.
# For example multiple OpenGL contexts may not be sharing vbos, ibos, textures (if they
# are set up to not share these amongs each other).
# In this case, you would set this config option to no.
textures-are-shared = yes

# Some effects (like lightning) need to be synchronized across multiple views.
# Re-seeding the atmosphere random number in these cases per view doesn't quite work right for those.
# To avoid this, set this value to yes.
# The tcs datas will use their own internal random generators in this case (which if seeded/reset the same,
# will synchronize the effects across the views)
tcs-data-effects-rng-unique = yes

##########################
# Sky Settings
##########################

# If you have some odd case where the Z coordinates of the sun and moon position seem
# to be the wrong sign (positive vs. negative,) setting this will flip the final Z
# coordinate computed for the sun and moon.
flip-ephemeris-z = no

# If your graphics hardware can support vertex shaders with more than 128 instructions,
# the complex sky shader will provide better transitions between day and night. If you
# can't be sure, then use the simpler shader which fits inside 128 instructions.
# Specifically, the complex shader models light from the sun and moon simultaneously
# instead of modeling just the dominant light source.
sky-simple-shader = no

# Width/height of each skybox face in world units. Only important in terms
# of making it fit within your view frustum.
sky-box-size = 1000

# Force the sky box to offset its height. Useful for compensating for terrains that
# don't extend to the horizon.
sky-box-y-offset = -40

# How many rows and columns are in each face of the sky box. Higher numbers
# result in smoother, more accurate sky colors at the cost of performance.
sky-box-resolution = 40

# Gamma value for the sky vertices; higher values will desaturate the sky, lower
# ones will give more contrast / darker colors.
sky-box-gamma-preetham = 2.2
sky-box-gamma-hosek = 2.4

# The default turbidity value, which you can think of as a measurement of how
# much haze is in the atmosphere.
#
#            1 = Pure air, range 256 km
#            2 = very clear, range 50 km
#            3 = clear, range 15 km
#            7 = light haze, range 8 km
#            20 = haze, range 3 km
#            50 = thin fog, range 2 km

default-turbidity = 3.0

# Selects the air mass model used. Default is SPECTRL2 which is what the Bird model uses.
# other options are the International Comet Quarterly model ("ICQ") or the National Renewable
# Energy Lab model ("NREL").
air-mass-model = SPECTRL2

# Sets the xy values in the xyY color used for twilight conditions.
twilight-chromaticity-x = 0.25
twilight-chromaticity-y = 0.25

# How much directional light is allowed after the sun goes below the horizon
twilight-directional-light = 0.0

# Scale the luminance of our twilight table values
twilight-scale = 1.0

# Sets tweaks for the color of the sky at sunset, in terms of the % boost given to each tristimulus
# value when the sun approaches the horizon. X is more or less "red"
sunset-X-boost = 0
sunset-Y-boost = 0
sunset-Z-boost = 0

# The sunset boost exponent controls how the color boosts are applied as the sun sets.
# Higher powers will apply the change more quickly as the sun approaches the horizon.
sunset-boost-exponent = 6

# Modulates the simulated air mass. More air means more scattering / more dramatic colors.
air-mass-multiplier = 1.0

# Shift the simulated spectra towards red. Valid values are 0-80. You can use this to make the sunsets
# less yellow.
spectrum-red-shift = 0

# Scaling factor for integrated star light / planetary light / zodiacal light / airglow / galactic light
# / cosmic light. Use this to control just how dark a moonless night is.
starlight-scale = 1.0

# Indicates if the sun disc should be drawn when it's below the local horizon. You might want this
# if you're viewing the Earth from space, for example.
draw-sun-below-horizon = no

# Controls whether the sun/moon disc should take on the color of the tone-mapped light it emits.
# If yes, the sun/moon will turn reddish as it nears the horizon. If no, it will always be white.
# Leave this to "no" for space-based applications.
scatter-sun-color = yes
scatter-moon-color = yes

# The width of the solar disc in degrees. This is actually 0.5 but that looks "wrong" to most
# viewers. The sun glare, if enabled, will make it look bigger too.
sun-width-degrees = 1.0

# The width of the lunar disc in degrees. This is also 0.5 degrees in actuality, but people
# are conditioned to expect it to be much larger based on film and games.
moon-width-degrees = 1.0

# Enables a radial gradient from the sun or moon position for a simple glow effect
enable-sun-glow = yes
enable-moon-glow = no

# The size of the glow effect, in degrees
sun-glow-size = 3.0
moon-glow-size = 3.0

# The size of the sun glow effect when infrared sensor mode is on, in degrees
sun-glow-size-infrared = 10.0

# The additive intensity of the glow effect
sun-glow-intensity = 0.08
moon-glow-intensity = 0.5

# How much the moon is dimmed during daylight
daylight-moon-dimming = 0.1

# The maximum luminance from skylight alone allowed in the simulation, after tone mapping.
max-skylight-luminance = 1.0

# Scale factor for solar and lunar radiation prior to tone mapping
# In HDR mode, this can be used to influence the brightness of the clouds
# independently from the sky
sun-luminance-scale = 1.0
moon-luminance-scale = 0.25

# Scale factor to make the moon less bright in the sky at night
moon-brightness-scale = 0.01

# Scale to brighten up the moon itself, independent of how it illuminates
# the scene and the sky
moon-brightness = 2.0
# Same value, when HDR is on
moon-brightness-hdr = 2.0

# Scale factors for the raw computation of the transmitted and scattered luminances of the
# sun and moon. This becomes important if you're using Atmosphere::EnableHDR() to give you
# control over the luminosity of the sky and clouds relative to the rest of your scene.
# Separate settings exist for when HDR mode is or is not enabled.
sun-transmission-scale = 1.0
sun-scattered-scale = 0.1
moon-transmission-scale = 0.4
moon-scattered-scale = 1.0

sun-transmission-scale-hdr = 1.0
sun-scattered-scale-hdr = 1.0
moon-transmission-scale-hdr = 1.0
moon-scattered-scale-hdr = 1.0

# When using the Hosek-Wilkie sky model (the new default,) this may be used to scale the radiance
# simulated when drawing the sky. Again this is useful with Atmosphere::EnableHDR() when you need
# to scale down the sky colors.
hosek-wilkie-radiance-scale = 1.0

# Whether ambient light should reduce with altitude.
atmosphere-isothermal-effect = yes

# Simulated ozone amount, in atm-cm. This is important for making sunsets orange instead of yellow.
# If you have data in "Dobson units", 100 Dobson Units = 0.100 atm-cm. 0.35 is typical, but if
# you happen to be in Antarctica under the ozone hole, it's more like 0.20.
atmosphere-ozone-mass = 0.35

# Simulated water vapor amount, in atm-cm
atmosphere-water-vapor-mass = 2.5

# Affects darkening or brightening of the horizon
perez-a-scale = 1.0

# Affects luminance gradient near the horizon
perez-b-scale = 1.0

# Affects relative intensity of circumsolar region
perez-c-scale = 1.0

# Affects width of the circumsolar region
perez-d-scale = 1.0

# Affects relative backscattered light
perez-e-scale = 1.0

# Ground albedo (realistic value would be 0.3, but this leads to horizons
# that are too pink for our expectations when using the Preetham sky model.)
ground-albedo-hosek = 0.3
ground-albedo-preetham = 0.0

# Set to fog the clouds to whatever the sky color is at the horizon, instead of computing
# the sky color at the location of each individual cloud to fog against.
disable-per-cloud-fog = no

# By default the average horizon color is calculated based on the current field of view. By
# choosing a value greater than 0.0 you can overrule this default behavior and make sure a
# specific field of view is used. This, in combination with average-horizon-color-num-samples
# can be used in a multi-channel setup to make sure that all pipes, e.g. 10 pipes that together
# cover a 360 degrees projection, calculate the same average horizon color. This will prevent
# fog color differences between adjacent pipes.
# E.g. specify average-horizon-color-fov = 360 and average-horizon-color-num-samples = 10 to
# calculate the average horizon color over 360 degrees using 10 samples instead of the default 8
# samples from the current fov.
average-horizon-color-fov = -1.0

# Number of samples used to determine the average horizon color.
average-horizon-color-num-samples = 8

##########################
# Precipitation
##########################

# Allow SilverLining to set fog to simulate loss of visibility due to precipitation.
# You can manage this yourself using the formula visibility (km) = 11.6 * pow(R, -0.63)
# where R is the precipitation rate in mm/hr. The corresponding exponential fog density can be
# obtained from 3.91 / visibility (m)
enable-precipitation-visibility-effects = yes

# Whether fog will be set from precipitation attached using CloudLayer::SetPrecipitation().
apply-fog-from-cloud-precipitation = yes

# Whether fog from precipitation effects will be forced to be monochromatic
precipitation-fog-monochrome = no

# The percentage of a cloud's width or depth from the edge at which precipitation effects
# will start fading out.
cloud-edge-fade-threshold = 0.1

# Number of rain streak particles maintained for the maximum allowed precipitation intensity.
# Increase this for denser-looking rain or snow (at lower performance)
rain-max-particles = 30000
snow-max-particles = 100000
sleet-max-particles = 50000

# The upper limit on the number of particles rendered in the scene per frame. Useful for
# enforcing an upper bound on frame times.
rain-max-rendered-particles = 1500
snow-max-rendered-particles = 3000
sleet-max-rendered-particles = 2000

# The amount of simulated time per frame for the purpose of calculating the streak
# length for rain. If set to zero, the actual frame time will be used, multiplied by
# the velocity of the raindrop. We set this to 1/60 s however, to ensure consistent
# appearance regardless of framerate.
rain-streak-frame-time = 0.016667

# Ditto for sleet, although we just use this to control the length of the streak.
sleet-streak-frame-time = 0.01

# Switches whether rain streaks take camera motion into account. If yes, streaks will be drawn
# from the previous position relative to the camera to the new position relative to the camera.
# If no, they are drawn relative to world coordinates.
rain-streak-camera-coords = no

# Ditto for sleet
sleet-streak-camera-coords = no

# The maximum allowed rainfall, in millimeters per hour, at which rain-max-particles will
# be used.
rain-max-intensity = 30.0

# Same for snow (note, this is liquid equivalent rate in mm/hr, not snow accumulation rate.
# 25 mm/hr is considered "heavy snow"
snow-max-intensity = 30.0

# Ditto for sleet
sleet-max-intensity = 30.0

# The radius of the area surrounding the camera that new particles are introduced into.
rain-volume-radius = 10.0
snow-volume-radius = 8.0
sleet-volume-radius = 10.0

# Fudge factor for making rain streaks more visible. For realistic purism, set to 1.0,
# but just like real life, they'll be hard to see. Ignored if rain-constant-alpha is set
# to a non-zero value.
rain-streak-brightness = 2.0

# The transparency of a rain streak is determined by the size of the droplet and the length of
# the streak (which in turn depends on the frame time.) At high speeds, this may approach zero.
# This setting allows the engine to not bother rendering the particles at some point in order
# to conserve performance.
rain-alpha-threshold = 0.01

# If you'd rather have a constant alpha for the rain streaks regardless of the area they
# cover in a given frame, set this to non-zero and rain-streak-brightness will be ignored.
rain-constant-alpha = 0.0

# The alpha value for sleet particles. Sleet alpha is always constant.
sleet-alpha = 0.6

# You can also influence the simulated width of the rain streaks. Setting this to 1.0
# will give you realistic results of a few millimeters, but they are hard to see
# and won't cut it at all for broadcast video applications.
rain-streak-width-multiplier = 1.0

# And for sleet
sleet-streak-width-multiplier = 2.0

# At large fields of view, precipitation may become invisible as the droplets project
# to less than one pixel. This setting enforces a minimum particle size in screen space.
rain-minimum-pixels = 2.0
sleet-minimum-pixels = 2.0
snow-minimum-pixels = 5.0

# Ditto for snowflakes.
snowflake-size-multiplier = 5.0

# SilverLining will simulate accurate visibilty via fog in rain for the precipitation rate
# you specify, if enable-precipitation-visibility-effects is on. You might be surprised
# at just how limited visibility is in rain, typically a few kilometers. You can fudge
# the simulated visibility here.
rain-visibility-multiplier = 1.0

# A similar fudge factor for snow visibility
snow-visibility-multiplier = 3.0

# And for sleet
sleet-visibility-multiplier = 1.0

# This defines the slope of the exponential distribution curve on a log scale of snowflake sizes
# It generally varies from about 1.0 to 2.4 based on studies of lake effect snow on
# Lake Michigan (see Braham, Robert, "Snow Particle Size Spectra in Lake Effect Snows",
# 1990, Journal of Applied Meteorology, Vol 29 p 200-207)
snow-lambda = -16

# If yes, snow particles will be randomly rotated at initialization.
# If no, the particles will be billboarded to face the camera at all times.
snow-rotate-particles = no

# The color of snowflakes. Pure white looks a little cartoonish.
snow-color-r = 0.9
snow-color-g = 0.9
snow-color-b = 0.9
snow-color-a = 1.0

# The terminal velocity of snowflakes, in meters per second.
wet-snow-velocity = 2.0
dry-snow-velocity = 1.0

# A multiplier for the terminal velocity of raindrops, sleet, or snow particles.
# These may be adjusted at runtime.
rain-velocity-factor = 1.0
sleet-velocity-factor = 1.0
snow-velocity-factor = 1.0

# The near clipping plane when drawing snow/rain. Closer values will result in bigger flakes
# close to the camera.
snow-near-clip = 0.5
rain-near-clip = 1.0
sleet-near-clip = 1.0

# By default, precipitation effects disable reading of the depth buffer, so we can pull in the near
# clipping plane to show particles close to the camera. If you adjust your own near clipping plane
# to account for this, we won't have to, and we can use the depth buffer again as depth values
# will be consistent between precipitation and your scene. This can let you get around anomalies
# where precipitation appears to fall through the ground and remain visible. If you enable this,
# the "near-clip" values above won't be used.
rain-use-depth-buffer = no
snow-use-depth-buffer = no
sleet-use-depth-buffer = no

# Whether precipitation particles write to the depth buffer. Keep in mind depth values written will
# not be comparable to the rest of the scene unless the above *-use-depth-buffer settings are set
# to "yes".
rain-write-depth = no
snow-write-depth = no
sleet-write-depth = no

# Whether any skew in the projection matrix is removed prior to adjusting the near/far clip planes
# for precipitation. Relevant only when rain-use-depth-buffer etc. is set to "no".
precipitation-no-skew = yes

# Upper and lower bounds of the frame time, in seconds, used for precipitation motion.
# Do not set precip-min-dt to zero, but it can be very close to zero if you want to
# allow "freezing time" and leaving precipitation hanging in air.
precip-min-dt = 0.01666667
precip-max-dt = 0.05

# Data for each particle instance is stored in a buffer and updated/sent to the GPU
# per frame.
# This can be via locking and updating the GPU side buffer directly,
# or using a CPU side 'shadow buffer', updating it and then sending it to the GPU.
# In most real world applications, there's speedup to be gained by using a cpu
# side shadow buffer.
# This avoids 'stalling' the gpu (which locking does). So, this is the default.
# In some cases, however, (depending on the driver, application characteristics
# (cpu bound, gpu bound, etc), it might be faster to lock the gpu side buffer
# and update it directly. In this case, set this parameter to 'no'
precip-particles-use-staging-buffer = yes

##########################
# Atmosphere from space
##########################

# If enabled, a blue ring will be drawn around the circumference of the Earth
# in geocentric coordinates - if the camera is positioned above the atmosphere
# (also in geocentric coordinates.)
enable-atmosphere-from-space = no

# When using geocentric mode, we assume that the Z axis is "north." If Y is north,
# set this to "no" so that the sun, moon, and stars are rendered consistently with the
# sky.
geocentric-z-is-up = yes

# When using geocentric mode with geocentric-z-is-up set to "no", specifies if the Z
# axis points through the prime meridian, instead of the X axis.
z-is-on-prime-meridian = no

# Enables / disables computation of the ring's vertices on the GPU
atmosphere-enable-shader = yes

# Number of segments of the atmosphere surrounding the image of the Earth,
# affects the granularity of culling.
num-atmosphere-segments = 10

# The number of polygon segments that make up each atmosphere segment
# laterally. Higher means better curves but slower.
atmosphere-segment-lateral-resolution = 20

# The number of polygon segments from MSL to the top of the atmosphere.
# More means more accurate colors but slower.
atmosphere-segment-vertical-resolution = 6

# Radius of the Earth in meters, used for the atmosphere from space
# and for positioning clouds at a given MSL in ECEF coordinates.
earth-radius-meters-polar = 6356752.3142
earth-radius-meters-equatorial = 6378137

# Thickness of the atmosphere, if the density were uniform (H0)
# Density at height h is given by exp(-h/H0), where density 1.0
# equates to sea level
atmosphere-scale-height-meters = 8435

# Height to which we stop rendering the atmsophere, in meters.
atmosphere-height = 300000

# Brightness of the rendered atmosphere
atmosphere-brightness = 3.0

# Distance over which the atmosphere fades to blackness
atmosphere-fade-distance = 1000000.0

##########################
# Glare Settings
##########################

# The overall brightness of glare effects
glare-brightness = 0.005

# The upper bound of tone-mapped luminance to compute glare for.
glare-luminance-cap = 1.5

# Disable the physically-based glare simulation on the sun
# (This causes performance issues on some Nvidia drivers)
disable-sun-glare = yes

# Disable the physically-based glare simulation on the moon
disable-moon-glare = yes

# Disable the physically-base glare simulation on bright stars
# It looks nice, but it does incur a performance penalty on some systems, so
# it's disabled by default.
disable-star-glare = yes

# Set the minimum visual magnitude of displayed stars (remember negative is brighter)
minimum-star-magnitude = 4.5

# An optional comma separated file for the star catalog. By default, SilverLining
# uses a hard coded (in code) star catalog. Specifying this file, will have
# SilverLining use the values from the file instead.
# The format for each entry is (visualMagnitude, ra, dec, r, g, b, raProperMotion, decProperMotion).
# Each entry is on a new line.
# The final entry should have an invalid  value of {9999, -1, -1, 0, 0, 0, 0, 0}.
# sample usage: star-catalog-file = starcat.csv
star-catalog-file = none

# The amount of light pollution at which stars become completely washed out
star-maximum-light-pollution = 0.01

# Set the minimum visual magnitude of displayed stars that compute glare
minimum-star-glare-magnitude = 1.0

# The size of each star point, in pixels. (Only honored in OpenGL)
star-point-size = 1.0

# Adds the given value to the simulated magnitude of each star.
# (negative is brighter, positive is dimmer.)
star-magnitude-adjustment = 0

# Enable flare lines on the solar / lunar glare
photopic-disc-flare-lines = yes

# Enable lenticular halos on mesopic / scotopic glares
lenticular-halos = no

# The width, in degrees, spanned by each glare texture. Apparent width is bounded
# by this.
max-glare-diameter = 10.0

# The number of randomly distributed flare lines
flare-lines = 350

# The exponential rate at which flare lines influence the image with distance from the light source
# ie, 1.0 = linear falloff, 0.5 is the square root of normalized distance, 2.0 is squared.
# Smaller numbers will generally result in more brightness in the center of the flare, larger numbers
# shrink the central blurry point light.
flare-falloff = 1.2

#########################
# Lens Flare Settings
#########################

# If you're sure you won't be using lens flare or Atmosphere::GetSunOcclusion(), set this
# to yes in order to avoid pipeline stalls when the sun is in view. This can have a
# substantial performance benefit if you don't need this effect.
disable-lens-flare = no

# This enables use of Pixel Buffer Objects in OpenGL in order to prevent occlusion tests
# for lens flare from blocking. This may not work if you are rendering to a texture, ie,
# in deferred rendering. But if you're rendering to the framebuffer, enabling this
# can produce a huge speedup when the sun is in view under OpenGL.
lens-flare-use-pbo = no

# Selects whether to use hexagonal flares, as opposed to circular flares.
# In reality, this would depend on the type of aperture on the camera being
# used. Most lens flares I see in TV and film lately seem to be hexagonal.
use-hex-flares = no

# The overall size of each flare as a percentage of the viewport width
lens-flare-size = 0.2

# How quickly the flare dims as it passes behind clouds or other occluders.
lens-flare-falloff = 4.0

# The overall brightness of the flare effects.
lens-flare-brightness = 0.7

# Whether occlusion tests on lens flare are disabled. This can increase performance when the
# sun is in view, but will cause lens flare to appear even when the sun is behind an object.
# note: currently, occlusion queries do not work if you are using deferred rendering. so make sure to set this to yes.
lens-flare-disable-occlusion = no

# Whether shine / sparkle effects at the sun are used or not.
lens-flare-shine = no

#########################
# Lightning Settings
#########################

# Color of lightning segments
lightning-color-r = 1.0
lightning-color-g = 1.0
lightning-color-b = 1.0
lightning-color-a = 1.0

# Width of glow around lightning, relative to segment width
lightning-glow-width = 4.0

# Color of glow around lightning
lightning-glow-color-r = 1.0
lightning-glow-color-g = 0.8
lightning-glow-color-b = 0.7
lightning-glow-color-a = 0.2

# Multiplier for HDR mode - how many kcd / m^2 should lightning be?
lightning-hdr-boost = 10.0

# How strong is lightning as a light source, for purposes of illuminating the cloud it's in
lightning-light = 5E4

# How thick is the main branch of the lightning, in pixels
lightning-initial-thickness = 4.0

# Maximum number of lightning segments per branch (controls branch length)
lightning-max-segments-per-branch = 35

# Maximum length of an individual lightning segment
lightning-max-segment-length = 100.0

# Maximum angle between successive segments (degrees)
lightning-max-segment-angle = 60.0

# Odds of a branch spawning off from a segment
lightning-max-branch-probability = 0.1

# Branches that get below this thickness stop (relative to parent branch)
lightning-min-branch-thickness = 0.3

# Branches start at this thickness relative to parent branch
lightning-max-branch-thickness = 0.6

# Each branch thins out at this rate
lightning-thickness-reduction = 0.8

# The default lightning discharge mode. May be auto-discharge, fire-and-forget, or fire-on-off.
lightning-discharge-mode = auto-discharge

# Maximum time between lightning discharges for a given lightning object in ms
lightning-max-discharge-period = 100000

# Time of lightning discharge in ms
lightning-discharge-ms = 500

# The distance from the camera at which lighting bolts go to zero width in screen space
# (in meters)
lightning-perspective-distance = 100000

# Added length to the lightning, if you need it to extend below sea level.
lightning-length-extension = 0

#########################
# Cloud Settings
#########################

# Whether billboards are recomputed for each individual cumulus cloud, to prevent puffs from
# moving independently within the same cloud.
cumulus-billboards-per-cloud = no

# Uses an alternative algorithm for positioning cumulus clouds in geocentric databases.
# Can be toggled if you are seeing banding in the clouds that shouldn't be there, or
# other anomalies.
alternate-geocentric-adjustment = no

# Draws cumulus clouds using bindless graphics and indirect, multi-draw.
# In the best case, this will draw all cumulus clouds across all layers
# in one draw call.
# For our tests, this gives us a speed up of atleast 2X.
# This is currently only supported for the OpenGL or OpenGL32 renderer.
# This works only on NVIDIA Gpus or Gpus with support for nvidia bindless graphics extensions.
# note: currently this option does not work if you are using deferred rendering, or an
# OpenGL core (non-compatibility) profile.
# Also note, this option will use UBO's and SSBO's regardless of the setting for use-ubos.
cumulus-draw-bindless-indirect = yes

# Sets whether we load cloud data from VRML format or custom format.
use-vrml-cloud-format =  no

# Sets whether cloud voxels that are completely surrounded by other voxels (and therefore not
# visible) should be culled.
# Surprisingly, this doesn't really happen too often, so the performance you'll get from this
# is pretty minimal and likely not worth the potential anomalies in lighting.
cull-interior-voxels = no

# The angle the light source must change by before triggering the relighting of clouds. (In degrees)
cloud-light-change-angle = 1.0

# Upper bound on the brightness of a given cloud puff to prevent oversaturation when blended together
# additively. Ignored in HDR mode.
max-metaball-color = 0.9

# The maximum number of times we will attempt to randomly position a cloud such that it does not
# intersect with another cloud.
max-cloud-position-retries = 30

# If we cannot position a cloud such that it does not intersect with another cloud, do we just
# fail and sacrifice coverage for reducing popping?
cloud-never-allow-intersection = no

# Texel dimension of the procedural puff textures (should be a power of 2)
# Bigger values look a little nicer, but at a big performance cost. Texture bandwidth
# is our bottleneck.
metaball-texture-dimension = 32

# We add a little randomness to the final color of each metaball, to give clouds more depth
metaball-color-randomness = 0.1
metaball-color-randomness-hi-res = 0.02

# Random variation in cumulus voxel sizes, as a percentage of the target size
cumulus-voxel-size-variation = 0.2

# Whether billboard matrices used to orient cloud puffs are based on the view matrix alone,
# or based on de-projecting normalized device coordinates to take the effect of projection
# skew into account. "Yes" means the latter.
billboard-use-ndc = yes

# Increase to force cumulus clouds to take on more of the fog color.
billboard-fog-color-boost = 1.0

# By default billboards spin is enabled during normal rendering and
# disabled during shadow passes. Setting this to yes, will disable
# billboard spin for normal rendering as well as shadow rendering
# This is useful for testing, ensuring separate runs produce
# the same results, etc
billboard-spin-enabled-override-disabled = no

# Take the curvature of the Earth into account when placing cumulus clouds within large cumulus layers,
# unless it's non-infinite and non-geocentric.
cumulus-round-earth = yes

# Scales the radius used to curve cloud layers when SetCurveTowardGround() is true.
curve-toward-ground-radius-scale = 1.0

# Clouds are "compiled" for faster rendering, but must be redrawn periodically in order
# to properly sort its components relative to the camera. Once the angle from the last camera
# position exceeds this threshold (in degrees), a redraw will be forced.
cumulus-sorting-threshold-angle = 5

# The maximum number of cloud "compiles" to perform per frame. Too many at once can result
# in jerky performance.
cumulus-recompile-budget = 1

# Controls how many frames the fog calculation per-cloud is spread across for performance.
cumulus-spread-out-fog = no
cumulus-fog-refresh-frequency = 10

# Use this to disable the functionality provided by Atmosphere::GetCloudBounds() if you're not using
# it; this will gain back a small bit of performance.
compute-cloud-bounds = yes

# Whether every cloud in a cloud layer should be created on the first frame the layer is drawn,
# or new clouds should only be created once they enter the view frustum. Basically lets you trade
# off initializiation time for the cloud layer vs. stutters at runtime.
pre-init-clouds = yes

# Whether clouds should always be drawn together with the rest of the clouds in their layer,
# forcing them to be sorted first by layer position, then by their position within the layer.
# This can resolve some sorting anomalies among mixed types of non-infinite cloud layers.
sort-clouds-by-layer = no

# The maximum number of clouds relit per frame when the lighting conditions change. You can
# set this lower in order to spread out the relighting over time, and smooth out the performance
# hit that comes with changing the time of day.
cloud-relight-budget = 1000

# Alpha value at which a cumulus cloud will be culled.
cumulus-cull-fade-threshold = 0.01

# If runtime cloud growth is enabled via CloudLayer::SetCloudAnimationEffects(), this value
# caps the number of clouds that have a simulation run on them per frame, in order to
# maintain performance.
max-cellular-automata-updates-per-frame = 10

# The distance a ray of light must pass through a cloud volume before being extinguished.
# This may be overridden in specific cloud layers further down.
cumulus-lighting-attenuation = 1800
cumulus-lighting-attenuation-hi-res = 2000

# Switch to simulate cloud growth and extinction over time. You get a performance gain by
# disabling growth (ie, set to "yes"), although you can get away with leaving it on with no
# performance impact. Configure the effect with
# CloudLayer::SetCloudAnimationEffects().
disable-cloud-growth = no

# The "phase function" controls how much forward and backward scattering occurs within
# the cloud, which will make the parts of the clouds brighter or darker depending on the
# lighting conditions. Lots of forward scattering will transmit sunlight through the cloud,
# backward scattering will reflect it. There are various models of various accuracy and
# computing cost. See "Light Reflection Functions for Simulation of Clouds and Dusty Surfaces"
# by James Blinn (1982)

# Valid phase functions are (in increasing complexity)
# isotropic, anisotropic, rayleigh, lambertian, henyey-greenstein
phase-function = rayleigh

# If using henyey-greenstein, a "g" parameter is required, which is the eccentricity of the modeled
# ellipse for each particle. g=0 degenerates to isotropic; g less than 0 is mostly forward scattering,
# g greater than 1 is mostly backward scattering.
# This is a double-lobed HG model, so it actually blends between two HG functions using blend factor F.
henyey-greenstein-g1 = 0.85
henyey-greenstein-g2 = -0.1
henyey-greenstein-f = 0.85

# If using anisotropic, a "x" parameter describing the material controls the amount of forward
# scattering.
anisotropic-x = 0.1

# The filename of the cloud atlas texture used for hi-res cumulus clouds.
cloud-atlas-texture-name = CloudAtlas.tga

# Whether cloud atlas textures should be drawn with srcalpha / invsrcalpha blending
cloud-atlas-normal-blend = no

# Whether cumulus clouds will automatically get darker at higher cloud coverage values
cumulus-darken-with-density = yes

# The maximum amount of darkening if cumulus-darken-with-density is on.
cumulus-density-darkening = 0.10

# The minimum voxel size as a percent of the cloud size
cumulus-minimum-voxel-size-factor = 0.25

# The minimum height of a cumulus cloud (in voxels) before indistinct, rotating puffs
# are introduced in its bottom. (Ensures crisp-looking small clouds)
cumulus-minimum-spin-height = 4

# Whether objects (including large clouds such as stratus) are sorted based on distance
# from the centers to the camera, or by distance in screen depth from the camera. Setting
# this to "yes" will reduce popping artifacts as the camera moves, but at the expense of
# consistency when dealing with large, non-infinite cloud layers or across different cameras.
sort-by-screen-depth = yes

# How much individual puffs are "flattened" in cumulus clouds. Ranges from 0 (squished into
# nothing) to 1 (normal)
cumulus-voxel-flattening = 0.8

# Our model that populates clouds in cloud layers tends to underestimate how many clouds are
# needed to achieve the desired coverage. These "extra runs" will keep adding new clouds
# in an attempt to reach the coverage specified, at the expense of performance and
# initialization time.
cumulus-max-extra-generation-runs = 1

# How much error in the specified cloud layer density you are willing to tolerate.
cumulus-density-precision = 0.05

#########################
# Cirrus (also affects cirrocumulus)
#########################

# The rate at which the cloud fades toward the edges if SetFadeTowardEdges is set
cirrus-fade-falloff = 5.0

# Number of vertices per dimension for cirrus deck; affects quality of fog effects.
cirrus-grid-dimension = 10

# Curves vertices of the cirrus cloud with the curvature of the Earth, unless it's
# non-infinite and non-geocentric
cirrus-round-earth = yes

# How much directional light is reflected by the cloud
cirrus-extinction = 1.0

# How much ambient light is reflected by the cloud
cirrus-albedo = 0.1

# Density parameter for exponential fog while inside the cloud; also
# represents max density inside scud
cirrus-fog-density = 0.00001

# Fog color inside cloud
cirrus-fog-red = 0.9
cirrus-fog-blue = 0.9
cirrus-fog-green = 0.9

# Whether to use a 1024x1024 texture for cirrus instead of a 512x512
cirrus-hires = no

# Whether infinite cirrus cloud layers with SetFadeTowardEdges(true) appear to
# move with camera motion
cirrus-animate = yes

#########################
# Stratus
#########################

# Force the stratus cloud to be sorted as if it were an infinite plane, even
# if the layer is non-infinite. This can work around some sorting anomalies.
stratus-force-planar-sort = no

# The rate at which the cloud fades toward the edges if SetFadeTowardEdges is set
stratus-fade-falloff = 2.0

# Controls the exponent used to remap stratus density values to cutoff values in the
# stratus.tga texture. Higher values will result in lower coverage at lower density
# values; lower values will result in higher coverge at lower density values.
stratus-coverage-exponent = 0.6

# Curves vertices of the stratus cloud with the curvature of the Earth, unless
# it's non-infinite.
stratus-round-earth = yes

# Number of vertices per dimension for stratus deck, broken vs. solid
stratus-grid-dimension = 768
stratus-grid-dimension-solid = 128

# Exponent applied to vertex heights; lower values result in more "bulgy" clouds
# with wider bases.
stratus-cloud-bulgy-exponent = 0.8

# Scale the sky color used to light the diffuse scattering of the clouds and that
# shows through the cloud from the bottom
stratus-sky-color-scale-r = 0.8
stratus-sky-color-scale-g = 0.8
stratus-sky-color-scale-b = 0.8

# Scale the ground color that shows through the cloud from the top and is reflected
# from the bottom
stratus-ground-color-scale-r = 1.0
stratus-ground-color-scale-g = 1.0
stratus-ground-color-scale-b = 1.0

# Whether the tops of stratus clouds should be flat
stratus-flat-tops = no

# Amount final lighting values on the stratus layer are scaled by
stratus-deck-light-scale = 1.1

# Real dimensions of the "infinite" nimbostratus cloud planes.
stratus-deck-width = 240000
stratus-deck-height = 240000

# Depth of a transitional layer into the cloud
# DO NOT SET THIS TO ZERO or it will cause divide by zero issues
stratus-scud-thickness = 300

# The fog density at which the stratus geometry will no longer be rendered
# (prevents discontinuities at scud / cloud boundary)
stratus-fog-render-cutoff = 0.005

# Maximum optical thickness of the cloud
# Use this if you want to force some detail from the scud
# to show through the bottom of thick clouds.
stratus-max-optical-thickness = 700

# A factor applied to the simulated optical thickness of the cloud
# when computing transmittance (opacity)
stratus-extinction-factor = 0.5

# How much light gets through the cloud deck
stratus-light-transmission-ambient = 0.2
stratus-light-transmission-direct = 0.1

# Density parameter for exponential fog while inside the cloud; also
# represents max density inside scud
stratus-fog-density = 0.01

# The cloud density value beyond which overcast conditions are triggered
stratus-overcast-threshold = 0.5

# Fog color inside cloud
stratus-fog-red = 0.8
stratus-fog-blue = 0.8
stratus-fog-green = 0.8

# Whether visibility effects inside the cloud take into effect densities less than 1.0.
# If yes, no fog will appear if you move within open areas of the cloud layer.
# If no, you'll always get fog inside the stratus layer no matter what.
stratus-handle-broken-visibility = no

# Scales the size of stratus features. Creating a stratus layer of less than 50km in size
# will benefit from reducing this in order to increase detail
stratus-scale-factor = 1.0

#########################
# Cumulus Mediocris
#########################

# Size of each metaball voxel in world coordinates
# Making this bigger gives performance gains at the cost of quality.
# Making it smaller gives quality gains at the cost of performance.
cumulus-mediocris-voxel-dimension = 100.0

# Average radius of a droplet in this cloud (in meters)
# Ranges from 4.0-5.8 microns depending on pollution levels (polluted is less)
cumulus-mediocris-droplet-size = 5.0E-6

# Water content (g/m3)
cumulus-mediocris-water-content = 0.26

# Droplets per cubic centimeter
# This actually ranges from 400-1300 depending on pollution levels (polluted is more)
cumulus-mediocris-droplets-per-cubic-cm = 1200

# The cloud distributor will attempt to keep the cloud centers at least this far apart.
# This reduces artifacts from clouds re-sorting as the view angle changes.
cumulus-mediocris-minimum-cloud-distance-scale = 0.8

# Albedo of cloud particles (how much light they reflect)
cumulus-mediocris-albedo = 0.88

# Probability of a voxel spontaneously disappearing
cumulus-mediocris-extinction-probability = 0.05

# Probability of a voxel spontaneously entering a phase transition state
cumulus-mediocris-transition-probability = 0.001

# Probability of a voxel spontaneously gaining "humidity"
cumulus-mediocris-vapor-probability = 0.06

# Probability of the cloud ellipsoid's voxels having an initial state of "humidity"
cumulus-mediocris-initial-vapor-probability = 0.3

# Initial evolution steps; reducing this will give performance
# at cost of having younger clouds
cumulus-mediocris-initial-evolve = 10

# Seconds between cellular automata updates
cumulus-mediocris-time-step-interval = 10

# Cloud generation model
# plank-exponential is described in Plank, V.G., 1969: The size distribution of cumulus
# clouds in representative Florida populations. J. Appl. Meteor., 8, 46-67.

cumulus-mediocris-generation-model = plank-exponential
cumulus-mediocris-generation-chi = 0.984
#cumulus-mediocris-generation-alpha = 0.002317715
cumulus-mediocris-generation-alpha = 0.001
cumulus-mediocris-generation-nu = 0.8
cumulus-mediocris-generation-beta = -0.10
cumulus-mediocris-generation-min-size = 500
cumulus-mediocris-generation-max-size = 2000
cumulus-mediocris-generation-bandwidth = 100

# Cloud distribution model
# random distribution places all clouds randomly (but not overlapping) and does
# not simulate clustering.
cumulus-mediocris-distribution-model = random

# The distance a ray of light must pass
# through a cloud volume before being extinguished.
cumulus-mediocris-attenuation = 1800

# If the clouds appear too dark or too light for your tastes, this will modulate the
# ambient term from skylight.
cumulus-mediocris-ambient-scattering = 0.9
cumulus-mediocris-ambient-scattering-hi-res = 0.9

# The gradient along the vertical axis of each cloud puff to create smoother lighting.
cumulus-mediocris-vertical-gradient = 0.05

#########################
# Cumulus Congestus
#########################

# Size of each metaball voxel in world coordinates
# Making this bigger gives performance gains at the cost of quality.
# Making it smaller gives quality gains at the cost of performance.
cumulus-congestus-voxel-dimension = 300.0

# Average radius of a droplet in this cloud (in meters)
# Ranges from 4.0-5.8 microns depending on pollution levels (polluted is less)
cumulus-congestus-droplet-size = 5.8E-6

# Water content (g/m3)
cumulus-congestus-water-content = 0.26

# Droplets per cubic centimeter
# This actually ranges from 400-1300 depending on pollution levels (polluted is more)
cumulus-congestus-droplets-per-cubic-cm = 350

# The cloud distributor will attempt to keep the cloud centers at least this far apart.
# This reduces artifacts from clouds re-sorting as the view angle changes.
cumulus-congestus-minimum-cloud-distance-scale = 0.57

# Albedo of cloud particles (how much light they reflect)
cumulus-congestus-albedo = 0.92

# Probability of a voxel spontaneously disappearing
cumulus-congestus-extinction-probability = 0.1

# Probability of a voxel spontaneously entering a phase transition state
cumulus-congestus-transition-probability = 0.001

# Probability of a voxel spontaneously gaining "humidity"
cumulus-congestus-vapor-probability = 0.06

# Probability of the cloud ellipsoid's voxels having an initial state of "humidity"
cumulus-congestus-initial-vapor-probability = 0.3

# Initial evolution steps; reducing this will give performance
# at cost of having younger clouds
cumulus-congestus-initial-evolve = 30

# Modeled updraft used when shearing the cloud with wind (meters/sec)
cumulus-congestus-updraft-speed = 15

# Seconds between cellular automata updates
cumulus-congestus-time-step-interval = 15

# Cloud generation model
# plank-exponential is described in Plank, V.G., 1969: The size distribution of cumulus
# clouds in representative Florida populations. J. Appl. Meteor., 8, 46-67.

cumulus-congestus-generation-model = plank-exponential
cumulus-congestus-generation-chi = 0.984
cumulus-congestus-generation-alpha = 0.001
cumulus-congestus-generation-nu = 0.5
cumulus-congestus-generation-beta = -0.10
cumulus-congestus-generation-min-size = 500
cumulus-congestus-generation-max-size = 5000
cumulus-congestus-generation-bandwidth = 100

# Cloud distribution model
# random distribution places all clouds randomly and does
# not simulate clustering.
cumulus-congestus-distribution-model = random

# The distance a ray of light must pass
# through a cloud volume before being extinguished.
cumulus-congestus-attenuation = 3000
cumulus-congestus-attenuation-hi-res = 3500

# If the clouds appear too dark or too light for your tastes, this will modulate the
# ambient term from skylight.
cumulus-congestus-ambient-scattering = 0.77
cumulus-congestus-ambient-scattering-hi-res = 0.8

# The gradient along the vertical axis of each cloud puff to create smoother lighting.
cumulus-congestus-vertical-gradient = 0.3

#########################
# Towering Cumulus
#########################

# Size of each metaball voxel in world coordinates
# Making this bigger gives performance gains at the cost of quality.
# Making it smaller gives quality gains at the cost of performance.
towering-cumulus-voxel-dimension = 500.0

# Factor by which individual voxels are stretched out (ranges from 0 - 1, 1 being not stretched)
towering-cumulus-voxel-flattening = 1.0

# Average radius of a droplet in this cloud (in meters)
# Ranges from 4.0-5.8 microns depending on pollution levels (polluted is less)
towering-cumulus-droplet-size = 4E-6

# Water content (g/m3)
towering-cumulus-water-content = 0.26

# Droplets per cubic centimeter
# This actually ranges from 400-1300 depending on pollution levels (polluted is more)
towering-cumulus-droplets-per-cubic-cm = 350

# The cloud distributor will attempt to keep the cloud centers at least this far apart.
# This reduces artifacts from clouds re-sorting as the view angle changes.
towering-cumulus-minimum-cloud-distance-scale = 0.6

# Albedo of cloud particles (how much light they reflect)
towering-cumulus-albedo = 0.9

# Probability of a voxel spontaneously disappearing
towering-cumulus-extinction-probability = 0.1

# Probability of a voxel spontaneously entering a phase transition state
towering-cumulus-transition-probability = 0.001

# Probability of a voxel spontaneously gaining "humidity"
towering-cumulus-vapor-probability = 0.06

# Probability of the cloud ellipsoid's voxels having an initial state of "humidity"
towering-cumulus-initial-vapor-probability = 0.3

# Initial evolution steps; reducing this will give performance
# at cost of having younger clouds
towering-cumulus-initial-evolve = 15

# Modeled updraft used when shearing the cloud with wind (meters/sec)
towering-cumulus-updraft-speed = 15

# Seconds between cellular automata updates
towering-cumulus-time-step-interval = 15

# Cloud generation model
towering-cumulus-generation-model = random
towering-cumulus-generation-nu = 1.0
towering-cumulus-generation-beta = -0.10
towering-cumulus-generation-min-size = 5000
towering-cumulus-generation-max-size = 10000

# Cloud distribution model
# random distribution places all clouds randomly and does
# not simulate clustering.
towering-cumulus-distribution-model = random

# The distance a ray of light must pass
# through a cloud volume before being extinguished.
towering-cumulus-attenuation-hi-res = 5000

# If the clouds appear too dark or too light for your tastes, this will modulate the
# ambient term from skylight.
towering-cumulus-ambient-scattering = 0.8
towering-cumulus-ambient-scattering-hi-res = 0.8

# The gradient along the vertical axis of each cloud puff to create smoother lighting.
towering-cumulus-vertical-gradient = 0.2

#########################
# Cumulonimbus
#########################

# Factor by which individual voxels are stretched out (ranges from 0 - 1, 1 being not stretched)
cumulonimbus-voxel-flattening = 1.0

# Percentage of cloud height at which the "anvil" starts
cumulonimbus-anvil-height = 0.5

# Vertical stretching of virga (rain) plume beneath cloud
cumulonimbus-virga-height = 1.7

# Constriction of cloud shaft relative to anvil
cumulonimbus-shaft-constriction = 0.2

# Velocity of updraft within tower, used to model wind shear (meters / second)
cumulonimbus-updraft-speed = 20

# Probability of a voxel in the anvil being capable of spawning lightning
cumulonimbus-lightning-density = 0.1

# Size of each metaball voxel in world coordinates
# Making this bigger gives performance gains at the cost of quality.
# Making it smaller gives quality gains at the cost of performance.
cumulonimbus-voxel-dimension = 400.0

# Average radius of a droplet in this cloud (in meters)
# Ranges from 7-10 when growing, 9-10 when dissipating
cumulonimbus-droplet-size = 5E-6

# Water content (g/m3) (ranges from 1-3)
cumulonimbus-water-content = 2.0

# Droplets per cubic centimeter
# Generally around 500 for growing and 300 for dissipating
cumulonimbus-droplets-per-cubic-cm = 300

# Terminal velocity of a raindrop. Some general guidelines: 1m/min for fog, 1-2 m/s
# for drizzle (0.5mm drops), 9 m/s for a downpour (5mm drops), 10 m/s for hail
# Expressed in meters per second.
raindrop-terminal-velocity = 8.0

# Coefficient of drag of a raindrop
raindrop-drag-coefficient = 0.1

# Mass of a raindrop in kg
raindrop-mass-kg = 0.000034

# Radius of a raindrop in m
raindrop-radius-m = 0.0013

# Name of rain texture to use beneath cloud, or none
cumulonimbus-rain-texture = virga.tga

# The transparency of the rain texture beneath the cloud
virga-alpha = 0.2

# How quickly the rain textures randomly rotate, in radians per second
virga-drift-speed = 0.1

# The radius of the random rotation of rain textures, as a percentage
# of the diameter of the rain texture's billboard.
virga-drift-radius = 0.25

# The position of the rain texture relative to the bottom of the cloud
# 0.5 places it entirely under the cloud, lower values a bit into it.
virga-height-offset = 0.1

# The distance at which the virga texture fade out as you approach them.
virga-fade-distance = 10000.0

# Maximum velocity of wind underneath the cloud
raindrop-max-wind-velocity = 8.0

# Albedo of cloud particles (how much light they reflect)
cumulonimbus-albedo = 0.9

# Probability of a voxel spontaneously disappearing
cumulonimbus-extinction-probability = 0.06

# Probability of a voxel spontaneously entering a phase transition state
cumulonimbus-transition-probability = 0.0001

# Probability of a voxel spontaneously gaining "humidity"
cumulonimbus-vapor-probability = 0.06

# Probability of the cloud ellipsoid's voxels having an initial state of "humidity"
cumulonimbus-initial-vapor-probability = 0.2

# Initial evolution steps; reducing this will give performance
# at cost of having younger clouds
cumulonimbus-initial-evolve = 4

# Seconds between cellular automata updates
cumulonimbus-time-step-interval = 10

# Cumulonimbus layers consist of a single cloud that fill the layer specified,
# since these clouds are so huge and infrequent.
cumulonimbus-distribution-model = none

# The distance a ray of light must pass
# through a cloud volume before being extinguished.
cumulonimbus-attenuation-hi-res = 10000

# If the clouds appear too dark or too light for your tastes, this will modulate the
# ambient term from skylight.
cumulonimbus-ambient-scattering = 0.8
cumulonimbus-ambient-scattering-hi-res = 0.8

# The gradient along the vertical axis of each cloud puff to create smoother lighting.
cumulonimbus-vertical-gradient = 0.2

# Whether lightning should illuminate the cloud while firing.
cumulonimbus-illuminate-from-lightning = yes

#########################
# Stratocumulus
#########################

# Whether the bounding volume for the stratocumulus layer should read from the depth
# buffer. Unless you have implemented custom shader code to do depth compares per
# ray march against a depth texture you should leave this on.
stratocumulus-read-depth = yes

# Size of each metaball voxel in world coordinates
# Making this bigger gives performance gains at the cost of quality.
# Making it smaller gives quality gains at the cost of performance.
stratocumulus-voxel-dimension = 350.0

# How dense the stratcumulus cloud is (modulates the density specified for the cloud layer)
stratocumulus-density = 1.2

# Our model that populates clouds in cloud layers tends to underestimate how many clouds are
# needed to achieve the desired coverage. These "extra runs" will keep adding new clouds
# in an attempt to reach the coverage specified, at the expense of performance and
# initialization time.
stratocumulus-max-extra-generation-runs = 10

# How much error in the specified cloud layer density you are willing to tolerate.
stratocumulus-density-precision = 0.05

# The rate at which the cloud fades toward the edges if SetFadeTowardEdges is set
stratocumulus-fade-falloff = 10.0

# The maximum dimension of the cloud layer's width or length
stratocumulus-max-size = 200000.0

# The distance between samples taken during real-time ray casting of the
# cloud volume. Higher values will increase performance at the cost of
# artifacts.
stratocumulus-light-sampling-distance = 100.0

# How much random jitter is introduced in the volume rendering (giving detail to cloud edges.)
stratocumulus-jitter = 1100.0

# Percentage of incident light to add to each voxel from multiple scattering
stratocumulus-multiple-scattering-term = 0.45

# Percentage of skylight to add to each voxel
stratocumulus-skylight-term = 0.20

# Percentage of inscattering light added to directional lighting at each voxel
stratocumulus-inscattering-term = 0.75

# Average effective radius of a droplet in this cloud (in meters)
# Ranges from 5-15 microns depending on pollution levels (polluted is less)
stratocumulus-droplet-size = 5.5E-6

# Droplets per cubic centimeter
# This actually ranges from 400-1300 depending on pollution levels (polluted is more)
stratocumulus-droplets-per-cubic-cm = 400

# Albedo of cloud particles (how much light they reflect)
stratocumulus-albedo = 0.9

# Exponent applied to incoming direct light (can be used to tone down moonlight
# and make dawn/dusk effects last longer)
stratocumulus-light-exponent = 2.0

# Probability of a voxel spontaneously disappearing
stratocumulus-extinction-probability = 0.1

# Probability of a voxel spontaneously entering a phase transition state
stratocumulus-transition-probability = 0.001

# Probability of a voxel spontaneously gaining "humidity"
stratocumulus-vapor-probability = 0.1

# Initial evolution steps; reducing this will give performance
# at cost of having younger clouds
stratocumulus-initial-evolve = 20

# Cloud generation model
# plank-exponential is described in Plank, V.G., 1969: The size distribution of cumulus
# clouds in representative Florida populations. J. Appl. Meteor., 8, 46-67.

stratocumulus-generation-model = plank-exponential
stratocumulus-generation-chi = 0.984
stratocumulus-generation-alpha = 0.001
stratocumulus-generation-nu = 0.5
stratocumulus-generation-beta = -0.10
stratocumulus-generation-min-size = 500
stratocumulus-generation-max-size = 5000
stratocumulus-generation-bandwidth = 100

# individual stratocumulus cloud positions for stratocumulus
# are not updated when they are infinite cloud layers. They
# are just used while seeding the clouds and building up the 3D
# texture for the layer as a whole.
# Consequently, API calls like IsInsideCloud will not work properly
# as the cloud layers (and hence clouds) move with winds.
# Set this to yes, if it is desired to update the clouds as well
# in response to the wind.
update-stratocumulus-clouds-with-wind = no

############################
# Stratocumulus - Particles
############################

# Force the stratocumulus cloud to be sorted as if it were an infinite plane, even
# if the layer is non-infinite. This can work around some sorting anomalies.
stratocumulus-force-planar-sort = no

# Cloud particles will be re-sorted when their angle relative to the
# camera changes by this amount (in degrees)
stratocumulus-particle-sort-angle = 10.0

# The number of quads within the cloud layer that will be re-compiled
# per frame. Lower for better performance at the expense of more anomalies
stratocumulus-particle-recompile-frame-limit = 10

# Random variation in cloud puff darkness
stratocumulus-particle-randomness = 0.05

# How much the incoming direct light color is scaled down
# (roughly simulates scattering within the cloud)
stratocumulus-diffuse-scale = 0.3

# Overall brightness of the cloud particles
stratocumulus-particle-ambient-scattering = 0.3
stratocumulus-particle-ambient-scattering-hi-res = 0.3

# Smallest size of a cloud puff (in meters)
stratocumulus-particle-voxel-size = 1000.0

# Intensity of brightness gradient from bottom to top of each puff
stratocumulus-particle-puff-gradient = 0.2

# Maximum variance of cloud puff sizes between thin and thick areas
# of the cloud layer
stratocumulus-particle-thickness-variance = 0.2

# Size of each sub-quad within the cloud layer, in puffs on one side
stratocumulus-particle-quad-size = 10

# Scaling factor for voxels to ensure textures overlap
stratocumulus-particles-voxel-scale = 2.5

# How much ambient light is blended into direct light when computing
# the cloud puff colors
stratocumulus-particle-ambient-blend = 0.3

# The 4x4 texture atlas used for the stratocumulus cloud puffs
stratocumulus-particles-texture-name = puff-alpha.tga

# The amount of random variation in cloud puff altitudes
stratocumulus-particle-base-height-variation = 1500

# How flattened the voxels are
stratocumulus-voxel-flattening = 0.6

# The distance at which we start fading out quads of the layer to hide
# particle rotation effects, as a multiple of the quad size
stratocumulus-particles-distance-fade-length = 0.5

# The minimum amount this fading is allowed to achieve.
stratocumulus-particles-distance-fade-min = 0.2

##################################################
# Sandstorms
# (Uses cumulus congestus settings, plus these:)
##################################################

# The color of fog when inside a sandstorm
# They generally block out all light
sandstorm-fog-red = 0
sandstorm-fog-green = 0
sandstorm-fog-blue = 0

# The density of fog within a sandstorm
sandstorm-fog-density = 0.001

# The color of the dust cloud
sandstorm-dust-red = 0.91
sandstorm-dust-green = 0.72
sandstorm-dust-blue = 0.74

# As you descend into sandstorms, the fogging kicks in with a conservative estimate
# of the max height of the sandstorm clouds. This multiplier controls how
# sooner/later it kicks in. A value less than 1 will cause it to kick in later and might
# look visually more correct. Adjust per taste. Default is 1, retaining the inbuilt behavior
sandstorm-fog-altitude-multiplier = 1.0

#########################
# Crepuscular Rays
#########################

# Whether the effect is computed even if the sun is out of the frame
crepuscular-rays-always-on = yes

# Controls the overall intensity of the post-process
crepuscular-rays-exposure = 0.0037

# Dissipates each sample's contribution as the ray progresses away from the light source
crepuscular-rays-decay = 0.99

# Adjusts sampling frequency
crepuscular-rays-density = 1.0

# Controls the intensity of each sample
crepuscular-rays-weight = 4.0

# Size of the offscreen texture used to do the volumetric lighting
crepuscular-rays-texsize = 512

# The depth of the effect in clip space; use to adjust where the rays
# appear relative to the objects in your scene. A value of 0 will
# result in the rays appearing in front of everything; a value of 1
# will be behind everything. Something slightly less than 1 will
# push it out into the middle of the scene (remember this value is
# before the perspective divide.)
crepuscular-rays-depth = 0

#########################
# Shadow maps
#########################
# Size of the texture map returend by Atmosphere::GetShadowMap()
shadow-map-texture-size = 1024

# The sin of the sun angle below which shadows are faded out
# (prevents crazy shadows as the sun goes below the clouds.)
shadow-sun-height-cutoff = 0.1

# Whether the "fade toward edges" effect on cloud layers should also
# apply to the cloud shadows.
shadow-fade = no

#########################
# Environment maps
#########################
# Size of each face of the cube map returned by Atmosphere::GetEnvironmentMap()
environment-map-size = 256

# Whether stars are rendered into the environment map.
environment-map-enable-stars = no

# Whether lightning is rendered into the environment map.
environment-maps-have-lightning = no

# Always prevent clouds from drawing into the environment map, regardless of
# what is passed into Atmosphere::GetEnvironmentMap()'s drawClouds parameter.
environment-map-never-draw-clouds = no

# Whether cube map faces should be generated upside-down relative to
# OpenGL conventions, when DirectX is used as a renderer.
flip-dx-cube-map-faces = yes

# Whether cube map mip map levels are also automatically generated,
# when OpenGL 32 is used as the renderer.
# This is an expensive operation on the gpu, however.
# If you do want to use this however, you can amortize the cost
# by having the cube map generated every few frames or so or when camera
# moves a certain distance.
environment-map-generate-mipmaps = no

#########################
# Deprecated Settings
#########################

# We do not provide support or test the results when changing the settings
# below from their defaults.

# Disable the usage of vertex and fragment programs. Will likely cost both
# accuracy and speed at the gain of greater hardware compatibility.
disable-shaders = no

# Settings for legacy cloud shadow system
shadow-map-dimension = 512
shadow-map-darkness = 0.5

# enable-thread-safety config is not needed/deprecated if the tcs data paradigm is used in conjunction with multi-threaded.
# However, it is retained to provide backward compatibility with the old (non-tcs data) usage.
# Set this to 'yes' to enable it, if you experience any problems.
# This is going to be ultimately removed

# Use mutex objects to ensure DrawSky(), DrawClouds(), UpdateSkyAndClouds(), and
# CullObjects() are not called simultaneously from different threads. If your
# rendering engine is single threaded, you may set this to "no" to avoid the
# overhead of mutex locks.
enable-thread-safety = no

# In OpenGL there is a [min, max] range for the line width of anti-aliased lines.
# Values outside this range are clamped.
# These values are queried like so:
# float range[2] = { 0,0 };
# glGetFloatv(GL_ALIASED_LINE_WIDTH_RANGE, range);
#
# We draw lightning using anti-aliased lines. We compute the width of the lines in pixels algorithmically taking into account various factors.
# These values can be outside the [min, max] range. But they get clamped in OpenGL.
# On Vulkan, there is no such range. Therefore, these values do not get clamped. And your lighting can look different.
# So, to have the same behavior of lines on Vulkan as OpenGL, set these values that you query in opengl (as above) for your gpu.
# This will enable the Vulkan renderer to clamp the values the same as OpenGL.
vulkan-line-width-min = 1.0
vulkan-line-width-max = 10.0
