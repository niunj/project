include_guard(GLOBAL)

# Binary development files and data for the libraries below the engine layer.
# Keep extraction inside the build tree so all source snapshots stay immutable.
function(vsgraysim_prepare_base)
    set(_platform "${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
    if(NOT _platform STREQUAL "Linux/x86_64")
        message(FATAL_ERROR "No base library bundle for ${_platform}")
    endif()
    set(_bundle "${VSGRAYSIM_DEPENDENCY_SOURCE}/../deps/linux-x86_64-ubuntu22.04.tar.gz")
    set(_checksum "${_bundle}.sha256")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bundle}" "${_checksum}")
    file(READ "${_checksum}" _expected)
    string(STRIP "${_expected}" _expected)
    file(SHA256 "${_bundle}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Base library bundle SHA-256 mismatch: ${_bundle}")
    endif()
    set(_root "${CMAKE_BINARY_DIR}/third_party/base")
    set(_installed "")
    if(EXISTS "${_root}/.complete")
        file(READ "${_root}/.complete" _installed)
        string(STRIP "${_installed}" _installed)
    endif()
    if(NOT _installed STREQUAL _actual)
        set(_staging "${_root}.staging")
        file(REMOVE_RECURSE "${_staging}")
        file(MAKE_DIRECTORY "${_staging}")
        file(ARCHIVE_EXTRACT INPUT "${_bundle}" DESTINATION "${_staging}")
        file(WRITE "${_staging}/.complete" "${_actual}\n")
        file(REMOVE_RECURSE "${_root}")
        file(RENAME "${_staging}" "${_root}")
    endif()
    set(VSGRAYSIM_BASE_ROOT "${_root}" PARENT_SCOPE)
endfunction()
