#version 460
/// @file compute_lut.comp
/// @brief Bruneton 预计算大气 LUT GPU 生成 (transmittance/scattering/irradiance)。
///
/// 三个 compute dispatch:
///   1. transmittance: 256x64, 每线程一个 (viewHeight, sunCosZenith) → RGB 透过率
///   2. scattering: 32x32x32, 每线程一个 (height, viewCosZenith, sunCosZenith),
///      对 32 个 viewSunCosTheta 采样打包到 slice
///   3. irradiance: 64x16, 每线程一个 (height, sunCosZenith) → RGB 环境辐照度
///
/// 参考: Bruneton08, Hillaire17, Bruneton17

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ---- 大气常量 (与 sky_dome.frag 一致) ----
const float PI = 3.14159265359;
const float R_PLANET = 6371000.0;
const float ATMOSPHERE_HEIGHT = 100000.0;
const float H_RAYLEIGH = 8500.0;
const float H_MIE = 1200.0;
const vec3 BETA_RAYLEIGH = vec3(5.802e-6, 13.558e-6, 33.1e-6);
const vec3 BETA_MIE_SCAT = vec3(3.996e-6);
const vec3 BETA_MIE_EXT = BETA_MIE_SCAT / 0.9;
const vec3 BETA_OZONE = vec3(0.650e-6, 1.881e-6, 0.085e-6);
const float OZONE_CENTER = 25000.0;
const float OZONE_WIDTH = 15000.0;
const float MIE_G = 0.76;

// ---- Push constant ----
layout(push_constant) uniform PushConstants {
    uint mode;        // 0=transmittance, 1=scattering, 2=irradiance
    uint layerIndex;  // scattering: 当前 slice index (0..31)
} pc;

// ---- 输出纹理 ----
layout(set = 0, binding = 0, rg16f) uniform image2D transmittanceTex;
layout(set = 0, binding = 1, rgba16f) uniform image3D scatteringTex;
layout(set = 0, binding = 2, rgb16f) uniform image2D irradianceTex;

// ---- 辅助函数 ----
float rayleighDensity(float h) { return exp(-h / H_RAYLEIGH); }
float mieDensity(float h) { return exp(-h / H_MIE); }
float ozoneDensity(float h) { return max(0.0, 1.0 - abs(h - OZONE_CENTER) / OZONE_WIDTH); }

vec2 raySphereIntersect(vec3 origin, vec3 dir, float radius) {
    float b = dot(origin, dir);
    float c = dot(origin, origin) - radius * radius;
    float d = b * b - c;
    if (d < 0.0) return vec2(-1.0);
    d = sqrt(d);
    return vec2(-b - d, -b + d);
}

float rayleighPhase(float ct) { return (3.0 / (16.0 * PI)) * (1.0 + ct * ct); }

float miePhase(float ct, float g) {
    float g2 = g * g;
    return 3.0 * (1.0 - g2) * (1.0 + ct * ct) /
           ((8.0 * PI) * (2.0 + g2) * pow(1.0 + g2 - 2.0 * g * ct, 1.5));
}

// ---- Transmittance LUT ----
// 输入: (viewHeight/m, sunCosZenith)
// 输出: RGB 透过率
vec3 computeTransmittance(float viewHeight, float sunCosZenith) {
    vec3 cameraPos = vec3(0.0, R_PLANET + viewHeight, 0.0);
    vec3 sunDir = vec3(0.0, sunCosZenith, sqrt(max(0.0, 1.0 - sunCosZenith * sunCosZenith)));

    float rAtmos = R_PLANET + ATMOSPHERE_HEIGHT;
    vec2 atmosHit = raySphereIntersect(cameraPos, sunDir, rAtmos);
    if (atmosHit.y < 0.0) return vec3(0.0);

    float tNear = max(atmosHit.x, 0.0);
    float tFar = atmosHit.y;

    // 检查是否碰到地面
    vec2 groundHit = raySphereIntersect(cameraPos, sunDir, R_PLANET);
    if (groundHit.x > 0.0) return vec3(0.0);

    const int SAMPLES = 64;
    float stepLen = (tFar - tNear) / float(SAMPLES);
    vec3 opticalDepth = vec3(0.0);

    for (int i = 0; i < SAMPLES; ++i) {
        float t = tNear + (float(i) + 0.5) * stepLen;
        float h = length(cameraPos + sunDir * t) - R_PLANET;
        vec3 ext = BETA_RAYLEIGH * rayleighDensity(h)
                 + BETA_MIE_EXT * mieDensity(h)
                 + BETA_OZONE * ozoneDensity(h);
        opticalDepth += ext * stepLen;
    }

    return exp(-opticalDepth);
}

// ---- Single-scattering LUT ----
// 输入: (viewHeight, viewCosZenith, sunCosZenith, viewSunCosTheta)
// 输出: RGB 散射 (Rayleigh + Mie)
vec3 computeScattering(float viewHeight, float viewCosZenith, float sunCosZenith, float viewSunCosTheta) {
    vec3 cameraPos = vec3(0.0, R_PLANET + viewHeight, 0.0);

    float sinViewZenith = sqrt(max(0.0, 1.0 - viewCosZenith * viewCosZenith));
    vec3 viewDir = vec3(0.0, viewCosZenith, sinViewZenith);

    float sinSunZenith = sqrt(max(0.0, 1.0 - sunCosZenith * sunCosZenith));
    vec3 sunDir = vec3(0.0, sunCosZenith, sinSunZenith);

    // viewSunCosTheta 定义 viewDir 和 sunDir 的夹角
    // 从 viewCosZenith, sunCosZenith, viewSunCosTheta 重建 sunDir
    float cosPhi = (viewSunCosTheta - viewCosZenith * sunCosZenith) / max(sinViewZenith, 1e-4);
    cosPhi = clamp(cosPhi, -1.0, 1.0);
    float sinPhi = sqrt(max(0.0, 1.0 - cosPhi * cosPhi));
    sunDir = vec3(sinPhi, sunCosZenith, cosPhi);

    float rAtmos = R_PLANET + ATMOSPHERE_HEIGHT;
    vec2 atmosHit = raySphereIntersect(cameraPos, viewDir, rAtmos);
    if (atmosHit.y < 0.0) return vec3(0.0);

    float tNear = max(atmosHit.x, 0.0);
    float tFar = atmosHit.y;

    // 检查是否碰到地面
    float groundHit = raySphereIntersect(cameraPos, viewDir, R_PLANET).x;
    if (groundHit > 0.0) tFar = groundHit;

    const int VIEW_SAMPLES = 16;
    const int LIGHT_SAMPLES = 8;
    float viewStepLen = (tFar - tNear) / float(VIEW_SAMPLES);

    vec3 rayleighSum = vec3(0.0);
    vec3 mieSum = vec3(0.0);
    vec3 viewOpticalDepth = vec3(0.0);

    for (int i = 0; i < VIEW_SAMPLES; ++i) {
        float t = tNear + (float(i) + 0.5) * viewStepLen;
        vec3 p = cameraPos + viewDir * t;
        float h = length(p) - R_PLANET;

        float rhoR = rayleighDensity(h);
        float rhoM = mieDensity(h);
        float rhoO3 = ozoneDensity(h);
        vec3 localExt = BETA_RAYLEIGH * rhoR + BETA_MIE_EXT * rhoM + BETA_OZONE * rhoO3;
        viewOpticalDepth += localExt * viewStepLen;
        vec3 viewTransmittance = exp(-viewOpticalDepth);

        // 光源方向光学深度
        vec2 lightAtmosHit = raySphereIntersect(p, sunDir, rAtmos);
        vec3 sunTransmittance;
        if (lightAtmosHit.y < 0.0) {
            sunTransmittance = vec3(0.0);
        } else {
            float lightStepLen = lightAtmosHit.y / float(LIGHT_SAMPLES);
            vec3 lightOpticalDepth = vec3(0.0);
            for (int j = 0; j < LIGHT_SAMPLES; ++j) {
                float lt = (float(j) + 0.5) * lightStepLen;
                float lh = length(p + sunDir * lt) - R_PLANET;
                vec3 lext = BETA_RAYLEIGH * rayleighDensity(lh)
                          + BETA_MIE_EXT * mieDensity(lh)
                          + BETA_OZONE * ozoneDensity(lh);
                lightOpticalDepth += lext * lightStepLen;
            }
            sunTransmittance = exp(-(viewOpticalDepth + lightOpticalDepth));
        }

        rayleighSum += viewTransmittance * sunTransmittance * rhoR * viewStepLen;
        mieSum += viewTransmittance * sunTransmittance * rhoM * viewStepLen;
    }

    float cosTheta = dot(viewDir, sunDir);
    float phaseR = rayleighPhase(cosTheta);
    float phaseM = miePhase(cosTheta, MIE_G);

    return BETA_RAYLEIGH * phaseR * rayleighSum + BETA_MIE_SCAT * phaseM * mieSum;
}

// ---- Irradiance LUT ----
// 输入: (viewHeight, sunCosZenith)
// 输出: RGB 环境辐照度
vec3 computeIrradiance(float viewHeight, float sunCosZenith) {
    vec3 cameraPos = vec3(0.0, R_PLANET + viewHeight, 0.0);

    float sinSunZenith = sqrt(max(0.0, 1.0 - sunCosZenith * sunCosZenith));
    vec3 sunDir = vec3(0.0, sunCosZenith, sinSunZenith);

    float rAtmos = R_PLANET + ATMOSPHERE_HEIGHT;
    vec3 irradiance = vec3(0.0);

    const int SAMPLES = 32;
    for (int i = 0; i < SAMPLES; ++i) {
        float theta = (float(i) + 0.5) * PI / float(SAMPLES);
        float dTheta = PI / float(SAMPLES);

        vec3 sampleDir = vec3(0.0, cos(theta), sin(theta));
        float cosThetaSun = dot(sampleDir, sunDir);

        vec2 atmosHit = raySphereIntersect(cameraPos, sampleDir, rAtmos);
        if (atmosHit.y < 0.0) continue;

        float tNear = max(atmosHit.x, 0.0);
        float tFar = atmosHit.y;

        // 检查是否碰到地面
        float groundHit = raySphereIntersect(cameraPos, sampleDir, R_PLANET).x;
        if (groundHit > 0.0) tFar = groundHit;

        // 计算沿该方向的 transmittance
        vec3 transmittance = vec3(0.0);
        if (tFar > tNear) {
            const int TRANS_SAMPLES = 16;
            float transStepLen = (tFar - tNear) / float(TRANS_SAMPLES);
            vec3 transOD = vec3(0.0);
            for (int j = 0; j < TRANS_SAMPLES; ++j) {
                float t = tNear + (float(j) + 0.5) * transStepLen;
                float h = length(cameraPos + sampleDir * t) - R_PLANET;
                vec3 ext = BETA_RAYLEIGH * rayleighDensity(h)
                         + BETA_MIE_EXT * mieDensity(h)
                         + BETA_OZONE * ozoneDensity(h);
                transOD += ext * transStepLen;
            }
            transmittance = exp(-transOD);
        }

        // 添加该方向的贡献 (Lambert cosine)
        irradiance += transmittance * max(cosThetaSun, 0.0) * sin(theta) * dTheta;
    }

    return irradiance;
}

// ---- Main ----
void main() {
    if (pc.mode == 0) {
        // Transmittance LUT
        ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
        if (coord.x >= 256 || coord.y >= 64) return;

        float viewHeight = float(coord.y) / 63.0 * 64000.0;  // 0..64km
        float sunCosZenith = float(coord.x) / 255.0 * 2.0 - 1.0;  // -1..1

        vec3 transmittance = computeTransmittance(viewHeight, sunCosZenith);
        imageStore(transmittanceTex, coord, vec4(transmittance, 1.0));

    } else if (pc.mode == 1) {
        // Scattering LUT (单 slice)
        ivec3 coord = ivec3(gl_GlobalInvocationID.xy, pc.layerIndex);
        if (coord.x >= 32 || coord.y >= 32 || coord.z >= 32) return;

        float height = float(coord.z) / 31.0 * 64000.0;  // 0..64km
        float viewCosZenith = float(coord.y) / 31.0 * 2.0 - 1.0;  // -1..1
        float sunCosZenith = float(coord.x) / 31.0 * 2.0 - 1.0;  // -1..1
        float viewSunCosTheta = float(coord.x) / 31.0 * 2.0 - 1.0;  // -1..1

        vec3 scattering = computeScattering(height, viewCosZenith, sunCosZenith, viewSunCosTheta);
        imageStore(scatteringTex, coord, vec4(scattering, 1.0));

    } else if (pc.mode == 2) {
        // Irradiance LUT
        ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
        if (coord.x >= 64 || coord.y >= 16) return;

        float height = float(coord.y) / 15.0 * 64000.0;  // 0..64km
        float sunCosZenith = float(coord.x) / 63.0 * 2.0 - 1.0;  // -1..1

        vec3 irradiance = computeIrradiance(height, sunCosZenith);
        imageStore(irradianceTex, coord, vec4(irradiance, 1.0));
    }
}
