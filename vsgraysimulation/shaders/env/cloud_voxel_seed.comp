#version 450
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(set=0,binding=0,rgba32f) uniform image3D state0;
layout(set=0,binding=2,rgba32f) uniform image3D velocity0;
layout(std140,set=0,binding=4) uniform CloudParams {
    vec4 originCell; vec4 gridDt; vec4 windHumidity; vec4 thermo;
    vec4 phase; vec4 flow; vec4 colliderMeta;
    vec4 colliderCentre[32]; vec4 colliderVelocity[32];
} p;
layout(push_constant) uniform SeedPush { uint reset; uint seed; vec2 pad; } pc;

float saturationMixingRatio(float temperatureK,float pressurePa) {
    float tc=temperatureK-273.15;
    float es=610.94*exp(17.625*tc/(tc+243.04));
    return .622*es/max(pressurePa-es,1000.0);
}
float vapourMixingRatio(float temperatureK,float pressurePa,float relativeHumidity) {
    // Deliberately not clamped to 1: supersaturation is the seed mechanism
    // that lets the microphysics condense instead of painting condensate.
    return saturationMixingRatio(temperatureK,pressurePa)*max(relativeHumidity,0.05);
}
uint hash3(uvec3 p) {
    p=p*1664525u+1013904223u;
    p.x+=p.y*p.z;p.y+=p.z*p.x;p.z+=p.x*p.y;
    return p.x^p.y^p.z;
}
float weatherNoise(vec3 p,uint seed) {
    ivec3 cell=ivec3(floor(p));vec3 f=fract(p);f=f*f*(3.0-2.0*f);
    float value=0.0;
    for(int z=0;z<2;++z)for(int y=0;y<2;++y)for(int x=0;x<2;++x) {
        ivec3 corner=cell+ivec3(x,y,z);
        float sampleValue=float(hash3(uvec3(corner)+uvec3(seed,seed*17u,seed*37u))>>8u)/16777216.0;
        value+=sampleValue*(x==0?1.0-f.x:f.x)*(y==0?1.0-f.y:f.y)*(z==0?1.0-f.z:f.z);
    }
    return value;
}
float weatherSpectrum(vec3 p,uint seed) {
    float sum=0.0,weight=.55,normalization=0.0;
    for(int octave=0;octave<5;++octave) {
        sum+=weight*weatherNoise(p,seed+uint(octave)*101u);
        normalization+=weight;p=p*2.03+vec3(1.7,3.1,2.3);weight*=.52;
    }
    return sum/normalization;
}
void main() {
    ivec3 c=ivec3(gl_GlobalInvocationID.xyz), n=ivec3(p.gridDt.xyz);
    if(any(greaterThanEqual(c,n)))return;
    // P0: the seed pass only initializes the field. Without this early-out it
    // repainted state0/velocity0 every step and erased all evolved dynamics.
    if(pc.reset==0u)return;
    vec3 q=(vec3(c)+.5)/vec3(n);
    float cover=clamp(p.colliderMeta.w,0.0,1.0);
    // P0: fixed weather seed from the host config. Deriving it from the
    // simulation clock made every rebase draw a different weather pattern.
    uint seed=pc.seed^0x9e3779b9u;
    float height=max(q.y*float(n.y)*p.originCell.w,0.0);
    float ambientT=max(p.thermo.x-p.thermo.w*height,190.0);
    float pressure=p.thermo.y*exp(-p.thermo.z*height/(287.05*p.thermo.x));

    // Weather regimes drive the background state and the buoyant-forcing
    // field; condensate itself is still only produced by the microphysics.
    // stratiformCover selects a wide shallow layer deck, stormCover a deep
    // convective column; both interpolate with the fair-weather cumulus field.
    float stratiformCover=clamp(cover*cover*1.55,0.0,1.0);
    float stormCover=clamp(max(cover-.70,0.0)/.30,0.0,1.0);
    float cumulusCover=clamp(cover*(1.0-stratiformCover*.65),0.0,1.0);

    // Background humidity: nearer to saturation as coverage rises. The exact
    // level keeps clear environmental air below saturation so condensation
    // remains tied to the buoyant forcing below, not to the whole box.
    float backgroundRh=.60+.30*cover-.08*stormCover;

    vec2 warp=vec2(weatherSpectrum(q*vec3(2.1,1.3,2.1)+vec3(3.7,0,1.2),seed+11u),
                   weatherSpectrum(q*vec3(2.1,1.3,2.1)+vec3(.4,2.1,4.8),seed+29u))-.5;
    vec2 horizontal=q.xz+warp*.16-vec2(.5);
    float mesoscale=weatherSpectrum(q*vec3(3.2,2.0,3.2)+vec3(1.1,.3,2.7),seed+47u);
    float turbulent=weatherSpectrum(q*vec3(11.0,7.0,11.0)+vec3(5.2,1.7,.8),seed+83u);

    // Fair-weather cumulus forcing: compact convergence cells in the boundary
    // layer, exactly as before but scaled by the cumulus share of coverage.
    float convergence=1.0-smoothstep(.14,.54,length(horizontal));
    float top=.40+.34*mesoscale;
    float boundaryLayer=smoothstep(.07,.18,q.y)*(1.0-smoothstep(top-.17,top,q.y));
    float cumulus=convergence*boundaryLayer*smoothstep(.24,.61,.60*mesoscale+.40*turbulent);

    // Stratiform forcing: a broad, shallow, near-saturated layer spanning most
    // of the horizontal domain. Weak vertical motion keeps it a deck.
    float deck=smoothstep(.10,.22,q.y)*(1.0-smoothstep(.30,.46,q.y));
    deck*=smoothstep(.30,.62,.55*mesoscale+.45*turbulent);

    // Storm forcing: a deep column with strong correlation across the full
    // depth, feeding sustained updrafts and a tall cloud.
    float stormColumn=1.0-smoothstep(.10,.42,length(horizontal));
    float storm=stormColumn*smoothstep(.10,.26,q.y)*(1.0-smoothstep(.72,.94,q.y))*
                smoothstep(.34,.66,.52*mesoscale+.48*turbulent);

    float thermal=clamp(cumulus*cumulusCover+deck*stratiformCover*.9+storm*stormCover,0.0,1.0);
    float tempOffset=3.8*thermal+7.0*storm*stormCover;
    float localRh=mix(backgroundRh,1.18+.14*thermal,thermal);
    float vapour=vapourMixingRatio(ambientT+tempOffset,pressure,localRh);
    float qs=saturationMixingRatio(ambientT+tempOffset,pressure);
    float airDensity=pressure/(287.05*ambientT);
    // Seed with an already-supersaturated buoyant parcel so the microphysics
    // condenses immediately; condensate is never painted procedurally later.
    float supersaturation=clamp((vapour-qs)/max(qs,1e-5),0.0,.30);
    float liquid=airDensity*qs*supersaturation*1.05*thermal;
    imageStore(state0,c,vec4(vapour,liquid,tempOffset,0.0));
    // Three analytic solenoidal modes initialize resolved turbulence without
    // injecting divergence that the pressure solver would immediately erase.
    const float tau=6.28318530718;
    vec3 mode1=vec3(sin(tau*(3.0*q.z+.17)),0,cos(tau*(2.0*q.x+.31)));
    vec3 mode2=vec3(0,sin(tau*(4.0*q.x+.43)),cos(tau*(3.0*q.y+.29)));
    vec3 mode3=vec3(cos(tau*(2.0*q.y+.61)),sin(tau*(3.0*q.z+.11)),0);
    vec3 turbulentVelocity=(mode1+mode2*.65+mode3*.48)*(1.8+4.2*thermal);
    float updraft=(14.0*storm+16.0*thermal)*(0.55+0.45*turbulent);
    imageStore(velocity0,c,vec4(p.windHumidity.xyz+turbulentVelocity+vec3(0,updraft,0),0));
}
